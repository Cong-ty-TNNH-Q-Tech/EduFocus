{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloud": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "RateLimiting": {
    "PairingCreatePerHour": 10,
    "PairingClaimPerHour": 20,
    "RequestsPerMinute": 120,
    "SyncRequestsPerMinute": 60
  },
  "Sync": {
    "MaxEventsPerBatch": 50,
    "MaxBodyBytes": 65536,
    "DailySummaryWindowDays": 7
  },
  "Push": {
    "Enabled": false,
    "WebSocketEnabled": false,
    "WebSocketHeartbeatSeconds": 20,
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "VapidSubject": "",
    "AllowedEndpointHosts": [],
    "PollSeconds": 60,
    "MaxAttempts": 3,
    "BatchSize": 50
  },
  "Jobs": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "PairingSessionHours": 24,
    "SyncEventDays": 7,
    "NotificationDays": 30,
    "DailySummaryDays": 180,
    "CloudAuditDays": 365,
    "SoftDeletedFamilyDays": 30
  }
}
