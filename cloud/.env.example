# Copy to `.env` next to docker-compose.prod.yml and fill real values.
# `.env` is git-ignored; never commit real secrets or domains you want to keep private.

# --- Database (required) -----------------------------------------------------
# Use a long random password, e.g. `openssl rand -base64 32`.
POSTGRES_DB=edufocus_cloud
POSTGRES_USER=edufocus
POSTGRES_PASSWORD=change-me-strong-password

# --- Public endpoint ---------------------------------------------------------
# Production: https URL that phones can reach, no trailing slash.
EDUFOCUS_CLOUD_PUBLIC_URL=https://cloud.example.com
# Domain served by Caddy; must resolve to this VPS for automatic TLS.
EDUFOCUS_DOMAIN=cloud.example.com

# --- Image -------------------------------------------------------------------
# Leave unset to build locally (`docker compose build`). For production rollouts,
# point at a published tag, e.g. ghcr.io/cong-ty-tnnh-q-tech/edufocus-cloud-api:1.2.3
# CLOUD_API_IMAGE=

# --- Push (Firebase Cloud Messaging) ----------------------------------------
# Keep false for the first deploy and LAN demo. When true, place the service
# account JSON at ./secrets/firebase-service-account.json (mounted read-only).
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
PUSH_POLL_SECONDS=60

# --- Background jobs and retention ------------------------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60
JOBS_PAIRING_SESSION_HOURS=24
JOBS_SYNC_EVENT_DAYS=7
JOBS_NOTIFICATION_DAYS=30
JOBS_DAILY_SUMMARY_DAYS=180
JOBS_CLOUD_AUDIT_DAYS=365
JOBS_SOFT_DELETED_FAMILY_DAYS=30

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_PAIRING_CREATE_PER_HOUR=10
RATE_LIMIT_PAIRING_CLAIM_PER_HOUR=20
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SYNC_REQUESTS_PER_MINUTE=60

# --- Backups (scripts/backup.sh) --------------------------------------------
# Optional passphrase for gpg AES-256 encryption of pg_dump files.
BACKUP_PASSPHRASE=
BACKUP_KEEP=7

# --- Local development only (docker-compose.yml) ----------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
