# Copy to `.env` next to docker-compose.yml and fill real values.
# `.env` is git-ignored; never commit real secrets or private domains.

# --- Public endpoint ---------------------------------------------------------
# Production: https URL that phones can reach, no trailing slash.
EDUFOCUS_CLOUD_PUBLIC_URL=https://cloud.example.com
# Domain served by Caddy; must resolve to this VPS for automatic TLS.
# Used only when the `tls` profile is enabled.
EDUFOCUS_DOMAIN=cloud.example.com

# --- API binding -------------------------------------------------------------
# Keep 127.0.0.1 when Caddy terminates TLS. Use 0.0.0.0 only for a LAN demo.
API_BIND=127.0.0.1
API_PORT=8080
# Set to true behind the bundled Caddy proxy; false for direct LAN access.
CLOUD_TRUST_FORWARDED_HEADERS=true

# --- Database (SQLite, stored in the edufocus-data volume) -------------------
# Migrations run automatically at startup by default. Set false to run them
# explicitly with `docker compose run --rm api --migrate` before rollout.
EDUFOCUS_CLOUD_AUTO_MIGRATE=true

# --- Image -------------------------------------------------------------------
# Leave unset to build locally (`docker compose build`). For production rollouts,
# point at a published tag, e.g. ghcr.io/cong-ty-tnnh-q-tech/edufocus-cloud-api:1.2.3
# CLOUD_API_IMAGE=

# --- Push (backend WebSocket and optional UnifiedPush / Web Push) ------------
# The parent app keeps a WSS connection to /v1/push/stream, so no ntfy app is
# required. Web Push through ntfy remains optional as a fallback.
PUSH_WEBSOCKET_ENABLED=true
PUSH_WEBSOCKET_HEARTBEAT_SECONDS=20
# Set true only when using UnifiedPush/Web Push fallback. All VAPID values and
# at least one allowed endpoint host are then required. Generate the VAPID pair:
#   docker run --rm binwiederhier/ntfy webpush keys
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Host or host:port of the ntfy/Web Push endpoint. For multiple hosts, add
# additional Push__AllowedEndpointHosts__N entries in docker-compose.yml.
PUSH_ALLOWED_ENDPOINT_HOSTS=ntfy.example.com
PUSH_POLL_SECONDS=60

# --- Background jobs and retention ------------------------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60
JOBS_PAIRING_SESSION_HOURS=24
JOBS_SYNC_EVENT_DAYS=7
JOBS_NOTIFICATION_DAYS=30
JOBS_DAILY_SUMMARY_DAYS=180
JOBS_CLOUD_AUDIT_DAYS=365
JOBS_SOFT_DELETED_FAMILY_DAYS=30

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_PAIRING_CREATE_PER_HOUR=10
RATE_LIMIT_PAIRING_CLAIM_PER_HOUR=20
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SYNC_REQUESTS_PER_MINUTE=60

# --- Backups (scripts/backup.sh) --------------------------------------------
# Optional passphrase for gpg AES-256 encryption of SQLite backup files.
BACKUP_PASSPHRASE=
BACKUP_KEEP=7

# --- Local development only --------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Development
