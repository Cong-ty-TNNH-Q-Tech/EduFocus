<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4 installer definition for EduFocus. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="EduFocus"
    Manufacturer="ThanhTrunggDEV"
    Version="$(Version)"
    UpgradeCode="E3A4B2C1-9F8D-4E7A-B3C2-1A2B3C4D5E6F"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of EduFocus is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="Main" Title="EduFocus" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcutDesktop" />
      <ComponentRef Id="AppShortcutStartMenu" />
    </Feature>
  </Package>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="EduFocus" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuSubFolder" Name="EduFocus" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <File Id="MainExeFile" Source="$(PublishDir)EduFocus.exe" Name="EduFocus.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="AppShortcutDesktop" Directory="DesktopFolder"
               Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
      <Shortcut Id="ShortcutDesktop" Name="EduFocus" Description="EduFocus"
                Target="[INSTALLFOLDER]EduFocus.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveDesktopShortcut" Directory="DesktopFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ThanhTrunggDEV\EduFocus"
                     Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="AppShortcutStartMenu" Directory="ProgramMenuSubFolder"
               Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
      <Shortcut Id="ShortcutStartMenu" Name="EduFocus" Description="EduFocus"
                Target="[INSTALLFOLDER]EduFocus.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenu" Directory="ProgramMenuSubFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ThanhTrunggDEV\EduFocus"
                     Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>