<Window x:Class="EduFocus.WPF.ParentModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent Mode"
        Height="760" Width="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5B6270" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="SecretBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#C9CEDB" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,18,0,0" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#2F6FED" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Parent Mode" FontSize="26" FontWeight="SemiBold" Foreground="#1F2430" />
            <TextBlock Text="Xác thực phụ huynh để thay đổi các cài đặt được bảo vệ."
                       FontSize="13" Foreground="#5B6270" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="22" CornerRadius="12"
                Background="White" BorderBrush="#E1E4EC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Đang chuẩn bị dữ liệu..." FontSize="14" Foreground="#5B6270" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Chưa thiết lập Parent Mode" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#5B6270" TextWrapping="Wrap"
                                   Text="Máy này chưa có PIN phụ huynh. Trình thiết lập lần đầu sẽ được bổ sung ở bản cập nhật kế tiếp." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Không thể mở Parent Mode" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#5B6270" TextWrapping="Wrap"
                                   Text="Dữ liệu cục bộ chưa sẵn sàng. Hãy chạy EduFocus bằng quyền quản trị rồi thử lại." />
                        <Button Content="Thử lại" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Đăng nhập phụ huynh" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Text="PIN phụ huynh" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="LoginPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="LoginPinBox_OnPasswordChanged"
                                     KeyDown="LoginPinBox_OnKeyDown" />
                        <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}" />
                        <Button Content="Quên PIN? Dùng mã khôi phục" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenRecoveryResetCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsManagementVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Parent Mode đang mở" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#5B6270" TextWrapping="Wrap"
                                   Text="Phiên sẽ tự khóa sau 5 phút không hoạt động. Đóng cửa sổ này cũng khóa phiên ngay." />

                        <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#F8F9FC"
                                BorderBrush="#DDE1EA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Bảo vệ học tập" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1F2430" />
                                <TextBlock Text="{Binding Protection.StatusText}" Margin="0,6,0,0"
                                           FontSize="13" Foreground="#5B6270" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Protection.WarningText}" Margin="0,8,0,0"
                                           FontSize="12" Foreground="#B42318" TextWrapping="Wrap"
                                           Visibility="{Binding Protection.HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{Binding Protection.ToggleButtonText}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ToggleProtectionCommand}"
                                        IsEnabled="{Binding Protection.IsNotBusy}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#F8F9FC"
                                BorderBrush="#DDE1EA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Lịch bảo vệ" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1F2430" />
                                <TextBlock Text="{Binding Schedule.ScheduleStatusText}" Margin="0,6,0,0"
                                           FontSize="13" Foreground="#5B6270" TextWrapping="Wrap" />
                                <Button Content="{Binding Schedule.ScheduleToggleText}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Schedule.ToggleScheduleCommand}"
                                        IsEnabled="{Binding Schedule.IsNotBusy}" />

                                <TextBlock Text="Chưa có khung giờ nào. Thêm khung giờ để bảo vệ tự bật theo lịch."
                                           Margin="0,10,0,0" FontSize="12.5" Foreground="#8A909C"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Schedule.HasNoWindows, Converter={StaticResource BoolToVisibility}}" />

                                <ListBox ItemsSource="{Binding Schedule.Windows}"
                                         SelectedItem="{Binding Schedule.SelectedWindow, Mode=TwoWay}"
                                         Margin="0,8,0,0" MaxHeight="170" BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" CornerRadius="8" Background="White"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#E1E4EC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter Property="BorderBrush" Value="#2F6FED" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#1F2430" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="12"
                                                                   Foreground="#5B6270" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                               FontSize="11.5" Foreground="#5B6270"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding Schedule.EditorTitle}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#1F2430" Margin="0,12,0,0" />
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox Content="T2" IsChecked="{Binding Schedule.Monday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="T3" IsChecked="{Binding Schedule.Tuesday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="T4" IsChecked="{Binding Schedule.Wednesday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="T5" IsChecked="{Binding Schedule.Thursday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="T6" IsChecked="{Binding Schedule.Friday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="T7" IsChecked="{Binding Schedule.Saturday}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="CN" IsChecked="{Binding Schedule.Sunday}"
                                              Margin="0,0,10,4" />
                                </WrapPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bắt đầu" FontSize="11.5" Foreground="#5B6270" />
                                        <TextBox Text="{Binding Schedule.StartTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kết thúc" FontSize="11.5" Foreground="#5B6270" />
                                        <TextBox Text="{Binding Schedule.EndTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Định dạng 24 giờ HH:mm; 24:00 là hết ngày. Khung giờ không vắt qua nửa đêm."
                                           FontSize="11" Foreground="#8A909C" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Nhãn (không bắt buộc)" FontSize="11.5"
                                           Foreground="#5B6270" Margin="0,8,0,0" />
                                <TextBox Text="{Binding Schedule.WindowLabel, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="100" Padding="8,6" Margin="0,4,0,0" />
                                <CheckBox Content="Khung giờ đang bật"
                                          IsChecked="{Binding Schedule.WindowEnabled}" Margin="0,10,0,0" />
                                <Button Content="{Binding Schedule.SaveButtonText}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Schedule.SaveWindowCommand}"
                                        IsEnabled="{Binding Schedule.IsNotBusy}" />
                                <Button Content="Xóa khung giờ" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Schedule.DeleteWindowCommand}"
                                        Visibility="{Binding Schedule.CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Thêm khung giờ mới" Style="{StaticResource LinkButton}"
                                        Command="{Binding Schedule.NewWindowCommand}" />
                                <TextBlock Text="{Binding Schedule.StatusMessage}" Margin="0,8,0,0"
                                           FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding Schedule.HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5B6270" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Schedule.StatusIsError}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#B42318" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Đổi PIN phụ huynh" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenChangePinCommand}" />
                        <Button Content="Khóa phiên" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LockSessionCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsChangePinVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Đổi PIN phụ huynh" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Text="PIN hiện tại" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="CurrentPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="CurrentPinBox_OnPasswordChanged" />
                        <TextBlock Text="PIN mới" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="NewPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="NewPinBox_OnPasswordChanged" />
                        <TextBlock Text="Xác nhận PIN mới" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ConfirmNewPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="ConfirmNewPinBox_OnPasswordChanged" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#8A909C" TextWrapping="Wrap"
                                   Text="PIN gồm 6–8 chữ số, không lặp lại một chữ số và không tăng/giảm liên tiếp." />
                        <Button Content="Xác nhận đổi PIN" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ChangePinCommand}" />
                        <Button Content="Quay lại" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelChangePinCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRecoveryResetVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Đặt lại PIN bằng mã khôi phục" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBlock Text="Mã khôi phục" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="RecoveryCodeBox" MaxLength="16" Style="{StaticResource SecretBox}"
                                     PasswordChanged="RecoveryCodeBox_OnPasswordChanged" />
                        <TextBlock Text="PIN mới" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ResetNewPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="ResetNewPinBox_OnPasswordChanged" />
                        <TextBlock Text="Xác nhận PIN mới" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ConfirmResetPinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                                     PasswordChanged="ConfirmResetPinBox_OnPasswordChanged" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#8A909C" TextWrapping="Wrap"
                                   Text="Mỗi mã khôi phục chỉ dùng được một lần. Sau khi đặt lại, hệ thống cấp một mã mới." />
                        <Button Content="Đặt lại PIN" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ResetPinCommand}" />
                        <Button Content="Quay lại đăng nhập" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BackToLoginCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRecoveryCodeVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Mã khôi phục mới" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1F2430" />
                        <TextBox Text="{Binding IssuedRecoveryCode, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="17" TextAlignment="Center"
                                 Padding="10" Background="#F4F5F9" BorderBrush="#C9CEDB" Margin="0,12,0,0" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#B42318" TextWrapping="Wrap"
                                   Text="Mã chỉ hiển thị một lần. Hãy ghi lại và cất giữ an toàn; mã cũ đã bị vô hiệu hóa." />
                        <Button Content="Tôi đã lưu mã" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AcknowledgeRecoveryCodeCommand}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5" MinHeight="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#5B6270" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="Đóng" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    MinWidth="90" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
