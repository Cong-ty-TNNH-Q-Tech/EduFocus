<Window x:Class="EduFocus.WPF.ParentModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduFocus — Parent Mode"
        Height="760" Width="1080"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="MetricTile" TargetType="Border" BasedOn="{StaticResource SoftCardBorder}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}" />
        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="SmallSoftButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <DataTemplate x:Key="ReportDayTemplate">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StudyText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding AttentionText}"
                               Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                               Margin="12,0,0,0" MaxWidth="220" TextAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportSessionTemplate">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AttentionText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Top" Margin="12,0,0,0" MaxWidth="140"
                               TextAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportTimelineTemplate">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TimeText}" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportTopActivityTemplate">
            <Border Style="{StaticResource RowCard}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding DetailText}" Style="{StaticResource SecondaryText}"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportAttentionEventTemplate">
            <Border Style="{StaticResource RowCard}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TimeText}" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlockRuleTemplate">
            <Border Style="{StaticResource RowCard}" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ToggleButtonText}"
                            Style="{StaticResource SmallSoftButton}" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.Blocklist.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding DataContext.Blocklist.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlockRuleGroupTemplate">
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource BlockRuleTemplate}"
                              Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="46" Height="46" CornerRadius="14"
                    Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Parent Mode" FontSize="23" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Khu vực dành cho phụ huynh — mọi thay đổi đều được bảo vệ bằng PIN."
                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center" Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Content states -->
        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardBorder}" Width="420" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Đang chuẩn bị dữ liệu..." Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="EduFocus đang mở dữ liệu cục bộ và kiểm tra phiên phụ huynh."
                               Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                    <ProgressBar IsIndeterminate="True" Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="470" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left"
                            Background="{StaticResource WarningSoftBrush}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyph}" FontSize="22"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <TextBlock Text="Chưa thiết lập Parent Mode" Style="{StaticResource SectionTitleText}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Máy này chưa có PIN phụ huynh. Hãy hoàn tất trình thiết lập lần đầu rồi mở lại Parent Mode."
                               Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                    <Button Content="Thử lại" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,20,0,0"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="470" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left"
                            Background="{StaticResource DangerSoftBrush}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyph}" FontSize="22"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <TextBlock Text="Không thể mở Parent Mode" Style="{StaticResource SectionTitleText}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Dữ liệu cục bộ chưa sẵn sàng. Hãy chạy EduFocus bằng quyền quản trị rồi thử lại."
                               Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                    <Button Content="Thử lại" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,20,0,0"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Border>

            <!-- Login -->
            <Border Style="{StaticResource CardBorder}" Width="440" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left"
                            Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="22"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                    </Border>
                    <TextBlock Text="Đăng nhập phụ huynh" Style="{StaticResource SectionTitleText}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Nhập PIN phụ huynh để mở các cài đặt được bảo vệ."
                               Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                    <TextBlock Text="PIN phụ huynh" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="LoginPinBox" MaxLength="8"
                                 PasswordChanged="LoginPinBox_OnPasswordChanged"
                                 KeyDown="LoginPinBox_OnKeyDown" />

                    <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Command="{Binding LoginCommand}" />
                    <Button Content="Quên PIN? Dùng mã khôi phục" Style="{StaticResource LinkButton}"
                            Margin="0,14,0,0" Command="{Binding OpenRecoveryResetCommand}" />

                    <TextBlock Text="PIN được kiểm tra trên chính máy này. EduFocus không lưu PIN dạng văn bản và tự khóa sau 5 phút không hoạt động."
                               Style="{StaticResource CaptionText}" Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <!-- Change PIN -->
            <Border Style="{StaticResource CardBorder}" Width="470" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsChangePinVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Đổi PIN phụ huynh" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="PIN mới sẽ thay thế PIN hiện tại ngay khi xác nhận."
                               Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                    <TextBlock Text="PIN hiện tại" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="CurrentPinBox" MaxLength="8"
                                 PasswordChanged="CurrentPinBox_OnPasswordChanged" />

                    <TextBlock Text="PIN mới" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="NewPinBox" MaxLength="8"
                                 PasswordChanged="NewPinBox_OnPasswordChanged" />

                    <TextBlock Text="Xác nhận PIN mới" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="ConfirmNewPinBox" MaxLength="8"
                                 PasswordChanged="ConfirmNewPinBox_OnPasswordChanged" />

                    <TextBlock Text="PIN gồm 6–8 chữ số, không lặp lại một chữ số và không tăng/giảm liên tiếp."
                               Style="{StaticResource CaptionText}" Margin="0,12,0,0" />

                    <Button Content="Xác nhận đổi PIN" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Command="{Binding ChangePinCommand}" />
                    <Button Content="Quay lại" Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0" Command="{Binding CancelChangePinCommand}" />
                </StackPanel>
            </Border>

            <!-- Recovery reset -->
            <Border Style="{StaticResource CardBorder}" Width="470" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsRecoveryResetVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Đặt lại PIN bằng mã khôi phục" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Dùng mã khôi phục đã lưu khi thiết lập để tạo PIN mới."
                               Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                    <TextBlock Text="Mã khôi phục" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="RecoveryCodeBox" MaxLength="16"
                                 PasswordChanged="RecoveryCodeBox_OnPasswordChanged" />

                    <TextBlock Text="PIN mới" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="ResetNewPinBox" MaxLength="8"
                                 PasswordChanged="ResetNewPinBox_OnPasswordChanged" />

                    <TextBlock Text="Xác nhận PIN mới" Style="{StaticResource FieldLabelText}" />
                    <PasswordBox x:Name="ConfirmResetPinBox" MaxLength="8"
                                 PasswordChanged="ConfirmResetPinBox_OnPasswordChanged" />

                    <TextBlock Text="Mỗi mã khôi phục chỉ dùng được một lần. Sau khi đặt lại, hệ thống cấp một mã mới."
                               Style="{StaticResource CaptionText}" Margin="0,12,0,0" />

                    <Button Content="Đặt lại PIN" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Command="{Binding ResetPinCommand}" />
                    <Button Content="Quay lại đăng nhập" Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0" Command="{Binding BackToLoginCommand}" />
                </StackPanel>
            </Border>

            <!-- Issued recovery code -->
            <Border Style="{StaticResource CardBorder}" Width="470" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsRecoveryCodeVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Mã khôi phục mới" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Mã chỉ hiển thị một lần. Hãy ghi lại và cất giữ an toàn; mã cũ đã bị vô hiệu hóa."
                               Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                    <TextBox Text="{Binding IssuedRecoveryCode, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="19" FontWeight="SemiBold"
                             TextAlignment="Center" Margin="0,16,0,0" />

                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="12"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <TextBlock Text="Không chia sẻ mã này với học sinh. Nếu mất mã, bạn vẫn có thể dùng PIN hiện tại để tạo mã mới trong Parent Mode."
                                   Style="{StaticResource SecondaryText}" />
                    </Border>

                    <Button Content="Tôi đã lưu mã" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Command="{Binding AcknowledgeRecoveryCodeCommand}" />
                </StackPanel>
            </Border>

            <!-- Management -->
            <Grid Visibility="{Binding IsManagementVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SoftCardBorder}" Padding="16,12"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Phiên quản trị đang mở" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="Tự khóa sau 5 phút không hoạt động" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="12,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Đổi PIN phụ huynh" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" Command="{Binding OpenChangePinCommand}" />
                            <Button Content="Khóa phiên" Style="{StaticResource SoftButton}"
                                    Command="{Binding LockSessionCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}">
                    <!-- Overview -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}" FontSize="14"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Tổng quan" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tổng quan hôm nay"
                                                           Style="{StaticResource CardTitleText}" />
                                                <TextBlock Text="Số liệu tổng hợp từ các phiên học trong ngày."
                                                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource PillBorder}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Dashboard.DateLabel}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                                                     Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Dashboard.ErrorMessage}"
                                                       Style="{StaticResource ErrorText}" />
                                            <Button Content="Thử lại" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Command="{Binding Dashboard.RetryCommand}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Dashboard.EmptyStateText}"
                                                   Style="{StaticResource BodyText}" Margin="0,14,0,0"
                                                   Visibility="{Binding Dashboard.ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Visibility="{Binding Dashboard.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Dashboard.ActiveSessionText}"
                                                       Style="{StaticResource BodyText}" Margin="0,14,0,0" />

                                            <UniformGrid Columns="3" Margin="0,6,-10,0">
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Thời gian học" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.StudyTimeText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Thời gian hoạt động" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.ActiveTimeText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Tập trung" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.AttentionText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Độ phủ camera" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.CoverageText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Mất tập trung" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.DistractionTimeText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Camera không khả dụng" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.CameraUnavailableTimeText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Không quan sát được" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.UnobservedTimeText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Bị chặn (best-effort)" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.BlockedAttemptsText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MetricTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="Phiên học" Style="{StaticResource MetricLabelText}" />
                                                        <TextBlock Text="{Binding Dashboard.SessionCountText}" Style="{StaticResource MetricValueText}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <TextBlock Text="{Binding Dashboard.CoverageWarning}" Margin="0,4,0,0"
                                                       Style="{StaticResource ErrorText}" FontWeight="SemiBold"
                                                       Visibility="{Binding Dashboard.HasCoverageWarning, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Dashboard.LastUpdatedText}"
                                                       Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="Số liệu tổng hợp, không quét mẫu thô. Số lần bị chặn chỉ gồm những gì EduFocus quan sát được."
                                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Bảo vệ học tập" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="{Binding Protection.StatusText}"
                                                       Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Protection.WarningText}"
                                                       Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                                       Visibility="{Binding Protection.HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{Binding Protection.ToggleButtonText}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,16,0,0"
                                                    Command="{Binding ToggleProtectionCommand}"
                                                    IsEnabled="{Binding Protection.IsNotBusy}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Camera giám sát" Style="{StaticResource CardTitleText}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{Binding Camera.IndicatorBrush}" />
                                                <TextBlock Text="{Binding Camera.StatusText}"
                                                           Style="{StaticResource SecondaryText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Camera.GuidanceText}"
                                                       Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                                       Visibility="{Binding Camera.HasGuidance, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="Chọn thiết bị và chạy kiểm tra camera trong thẻ Bảo vệ."
                                                       Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Reports -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}" FontSize="14"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Báo cáo" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Báo cáo học tập" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="Xem theo ngày, tuần hoặc 30 ngày gần nhất."
                                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Report.PeriodLabel}"
                                                   Style="{StaticResource SecondaryText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   TextAlignment="Right" MaxWidth="300" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding Report.Ranges}"
                                                  SelectedItem="{Binding Report.SelectedRange, Mode=TwoWay}"
                                                  DisplayMemberPath="Title" />
                                        <Button Grid.Column="1" Content="Làm mới"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding Report.ReloadCommand}"
                                                IsEnabled="{Binding Report.IsNotLoading}" />
                                        <Button Grid.Column="2" Content="{Binding Report.ExportButtonText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding Report.ExportCommand}" />
                                    </Grid>

                                    <TextBlock Text="File CSV chỉ gồm dữ liệu báo cáo đã lược bỏ tiêu đề cửa sổ, URL đầy đủ và dữ liệu camera. Hãy bảo vệ file sau khi xuất."
                                               Style="{StaticResource CaptionText}" Margin="0,10,0,0" />

                                    <TextBlock Text="{Binding Report.ExportMessage}" Margin="0,10,0,0"
                                               FontSize="12.5" TextWrapping="Wrap"
                                               Visibility="{Binding Report.HasExportMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Report.ExportIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                                                 Visibility="{Binding Report.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding Report.ErrorMessage}" Margin="0,12,0,0"
                                               Style="{StaticResource ErrorText}"
                                               Visibility="{Binding Report.HasError, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="Chưa có phiên học nào trong khoảng thời gian này."
                                               Style="{StaticResource BodyText}" Margin="0,14,0,0"
                                               Visibility="{Binding Report.ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Visibility="{Binding Report.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                                        <UniformGrid Columns="3" Margin="0,10,-10,0">
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Thời gian học" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.StudyTimeText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Thời gian hoạt động" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.ActiveTimeText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Tập trung" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.AttentionText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Độ phủ camera" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.CoverageText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Độ tin cậy" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.ConfidenceText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Thời gian quan sát" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.MonitoredTimeText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Mất tập trung" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.DistractionTimeText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Lớp học trực tuyến" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.OnlineClassTimeText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Phiên học" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.SessionCountText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricTile}">
                                                <StackPanel>
                                                    <TextBlock Text="Bị chặn (best-effort)" Style="{StaticResource MetricLabelText}" />
                                                    <TextBlock Text="{Binding Report.BlockedAttemptsText}" Style="{StaticResource MetricValueText}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Text="{Binding Report.WarningText}" Margin="0,4,0,0"
                                                   Style="{StaticResource ErrorText}" FontWeight="SemiBold"
                                                   Visibility="{Binding Report.HasWarnings, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Report.LastUpdatedText}"
                                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                                        <TextBlock Text="{Binding Report.DaysHeader}"
                                                   Style="{StaticResource SectionHeaderText}" />
                                        <ItemsControl ItemsSource="{Binding Report.DayRows}"
                                                      ItemTemplate="{StaticResource ReportDayTemplate}"
                                                      Visibility="{Binding Report.HasDayRows, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Report.SessionsHeader}"
                                                   Style="{StaticResource SectionHeaderText}" />
                                        <ItemsControl ItemsSource="{Binding Report.SessionRows}"
                                                      ItemTemplate="{StaticResource ReportSessionTemplate}"
                                                      Visibility="{Binding Report.HasSessionRows, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Report.TimelineHeader}"
                                                   Style="{StaticResource SectionHeaderText}" />
                                        <ItemsControl ItemsSource="{Binding Report.TimelineRows}"
                                                      ItemTemplate="{StaticResource ReportTimelineTemplate}"
                                                      Visibility="{Binding Report.HasTimelineRows, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="Tên miền / ứng dụng nổi bật"
                                                   Style="{StaticResource SectionHeaderText}" />
                                        <ItemsControl ItemsSource="{Binding Report.TopActivities}"
                                                      ItemTemplate="{StaticResource ReportTopActivityTemplate}"
                                                      Visibility="{Binding Report.HasTopActivities, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Report.AttentionHeader}"
                                                   Style="{StaticResource SectionHeaderText}" />
                                        <ItemsControl ItemsSource="{Binding Report.AttentionEventRows}"
                                                      ItemTemplate="{StaticResource ReportAttentionEventTemplate}"
                                                      Visibility="{Binding Report.HasAttentionEventRows, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Report.DataNote}"
                                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Protection and camera -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="14"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Bảo vệ" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Bảo vệ học tập" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="Bật hoặc tắt các giới hạn web và ứng dụng trên máy này."
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Protection.StatusText}"
                                                   Style="{StaticResource BodyText}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding Protection.WarningText}"
                                                   Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                                   Visibility="{Binding Protection.HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding Protection.ToggleButtonText}"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left" Margin="0,18,0,0"
                                                Command="{Binding ToggleProtectionCommand}"
                                                IsEnabled="{Binding Protection.IsNotBusy}" />

                                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="12"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="EduFocus chặn tên miền bằng hosts file, theo dõi ứng dụng bị chặn và tắt Secure DNS của Chrome/Edge. VPN hoặc thay đổi hệ thống có thể vượt qua — đây là công cụ hỗ trợ, không phải tường lửa tuyệt đối."
                                                       Style="{StaticResource SecondaryText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Camera giám sát" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="Camera chỉ được dùng để ước lượng tập trung; không lưu ảnh, video hay nhận diện danh tính."
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Camera.IndicatorBrush}" />
                                            <TextBlock Text="{Binding Camera.StatusText}"
                                                       Style="{StaticResource SecondaryText}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Camera.GuidanceText}"
                                                   Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                                   Visibility="{Binding Camera.HasGuidance, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="Camera EduFocus sử dụng" Style="{StaticResource FieldLabelText}" />
                                        <ComboBox ItemsSource="{Binding Camera.Devices}"
                                                  SelectedItem="{Binding Camera.SelectedDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Kiểm tra camera" Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,8" Command="{Binding Camera.RunCheckCommand}"
                                                    IsEnabled="{Binding Camera.CanRunCheck}" />
                                            <Button Content="Tải lại danh sách" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,8" Command="{Binding Camera.LoadDevicesCommand}"
                                                    IsEnabled="{Binding Camera.CanRunCheck}" />
                                            <Button Content="Dùng camera này" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,8" Command="{Binding Camera.SaveDeviceCommand}"
                                                    IsEnabled="{Binding Camera.CanSaveDevice}" />
                                            <Button Content="Dùng camera mặc định" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,0,8" Command="{Binding Camera.UseDefaultDeviceCommand}"
                                                    IsEnabled="{Binding Camera.CanRunCheck}" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Camera.FeedbackText}" Margin="0,4,0,0"
                                                   FontSize="12.5" TextWrapping="Wrap"
                                                   Visibility="{Binding Camera.HasFeedback, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Camera.FeedbackIsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Kiểm tra camera chỉ đọc vài khung hình trong bộ nhớ rồi đóng camera; không có ảnh nào được lưu."
                                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Schedule and blocklist -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" FontSize="14"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Lịch &amp; chặn" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6*" />
                                    <ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Lịch bảo vệ" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="{Binding Schedule.ScheduleStatusText}"
                                                   Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                        <Button Content="{Binding Schedule.ScheduleToggleText}"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                                Command="{Binding Schedule.ToggleScheduleCommand}"
                                                IsEnabled="{Binding Schedule.IsNotBusy}" />

                                        <TextBlock Text="Chưa có khung giờ nào. Thêm khung giờ để bảo vệ tự bật theo lịch."
                                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                                   Visibility="{Binding Schedule.HasNoWindows, Converter={StaticResource BoolToVisibility}}" />

                                        <ListBox ItemsSource="{Binding Schedule.Windows}"
                                                 SelectedItem="{Binding Schedule.SelectedWindow, Mode=TwoWay}"
                                                 Margin="0,12,0,0" MaxHeight="170" BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,4" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,9" CornerRadius="10" Background="White"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                 Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Margin="0,14,0,0" Padding="16" CornerRadius="12"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Schedule.EditorTitle}"
                                                           Style="{StaticResource CardTitleText}" FontSize="14" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <CheckBox Content="T2" IsChecked="{Binding Schedule.Monday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="T3" IsChecked="{Binding Schedule.Tuesday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="T4" IsChecked="{Binding Schedule.Wednesday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="T5" IsChecked="{Binding Schedule.Thursday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="T6" IsChecked="{Binding Schedule.Friday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="T7" IsChecked="{Binding Schedule.Saturday}" Margin="0,0,12,4" />
                                                    <CheckBox Content="CN" IsChecked="{Binding Schedule.Sunday}" Margin="0,0,12,4" />
                                                </WrapPanel>

                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Bắt đầu" Style="{StaticResource CaptionText}" />
                                                        <TextBox Text="{Binding Schedule.StartTime, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Kết thúc" Style="{StaticResource CaptionText}" />
                                                        <TextBox Text="{Binding Schedule.EndTime, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Định dạng 24 giờ HH:mm; 24:00 là hết ngày. Khung giờ không vắt qua nửa đêm."
                                                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

                                                <TextBlock Text="Nhãn (không bắt buộc)" Style="{StaticResource CaptionText}"
                                                           Margin="0,10,0,4" />
                                                <TextBox Text="{Binding Schedule.WindowLabel, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="100" />
                                                <CheckBox Content="Khung giờ đang bật"
                                                          IsChecked="{Binding Schedule.WindowEnabled}" Margin="0,12,0,0" />

                                                <Button Content="{Binding Schedule.SaveButtonText}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                                        Command="{Binding Schedule.SaveWindowCommand}"
                                                        IsEnabled="{Binding Schedule.IsNotBusy}" />
                                                <Button Content="Xóa khung giờ" Style="{StaticResource QuietDangerButton}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding Schedule.DeleteWindowCommand}"
                                                        Visibility="{Binding Schedule.CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="Thêm khung giờ mới" Style="{StaticResource LinkButton}"
                                                        Margin="0,10,0,0"
                                                        Command="{Binding Schedule.NewWindowCommand}" />
                                                <TextBlock Text="{Binding Schedule.StatusMessage}" Margin="0,10,0,0"
                                                           FontSize="12.5" TextWrapping="Wrap"
                                                           Visibility="{Binding Schedule.HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Schedule.StatusIsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Danh sách chặn" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="Rule mặc định đi kèm EduFocus. Bạn có thể tắt hoặc bật lại từng rule; rule mặc định không thể xóa."
                                                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                        <TextBlock Text="Chưa có rule nào. Rule mặc định sẽ được cài ở lần khởi động tới."
                                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                                   Visibility="{Binding Blocklist.HasNoRules, Converter={StaticResource BoolToVisibility}}" />

                                        <ItemsControl ItemsSource="{Binding Blocklist.Groups}"
                                                      ItemTemplate="{StaticResource BlockRuleGroupTemplate}"
                                                      Margin="0,2,0,0" />

                                        <TextBlock Text="{Binding Blocklist.StatusMessage}" Margin="0,12,0,0"
                                                   FontSize="12.5" TextWrapping="Wrap"
                                                   Visibility="{Binding Blocklist.HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Blocklist.StatusIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Settings -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="14"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Cài đặt" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Dữ liệu &amp; quyền riêng tư"
                                                           Style="{StaticResource CardTitleText}" />
                                                <TextBlock Text="Thiết lập giám sát, thời hạn lưu và lựa chọn ứng dụng."
                                                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource PillBorder}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Privacy.DatabaseSizeText}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Privacy.StorageSummary}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding Privacy.RetentionSummary}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Privacy.CameraSummary}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,4,0,0" />
                                        <Button Content="Xem thông báo quyền riêng tư đầy đủ"
                                                Style="{StaticResource LinkButton}" Margin="0,10,0,0"
                                                Click="OpenPrivacyNotice_OnClick" />

                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,0" />

                                        <CheckBox Content="Bật giám sát tập trung trong phiên học"
                                                  IsChecked="{Binding Privacy.MonitoringEnabled}" Margin="0,16,0,0" />
                                        <CheckBox Content="Chỉ giám sát trong giờ học trực tuyến"
                                                  IsChecked="{Binding Privacy.MonitorOnlyDuringClasses}" Margin="0,8,0,0" />
                                        <TextBlock Text="Tắt giám sát chỉ dừng camera và phân tích tập trung. Chặn web và ứng dụng theo rule và lịch vẫn hoạt động cho tới khi bạn tự tắt ở thẻ Bảo vệ."
                                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                                        <TextBlock Text="Ngưỡng phân tích" Style="{StaticResource SectionHeaderText}" Margin="0,14,0,0" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Xao nhãng (giây)" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.DistractionThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vắng mặt (giây)" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.AbsenceThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Ghi mẫu (giây)" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.SampleInterval, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Thời gian lưu dữ liệu (ngày)" Style="{StaticResource SectionHeaderText}" Margin="0,14,0,0" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hoạt động" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.ActivityRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Sự kiện tập trung" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.EventRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Phiên học" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Privacy.SessionRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Retention áp dụng ở lần dọn dẹp kế tiếp (định kỳ mỗi ngày). Dữ liệu cũ hơn số ngày này sẽ bị xóa cục bộ và không thể khôi phục."
                                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,0" />

                                        <CheckBox Content="Khởi động cùng Windows"
                                                  IsChecked="{Binding Privacy.StartWithWindows}" Margin="0,16,0,0" />
                                        <TextBlock Text="Lựa chọn được lưu ngay; cơ chế đăng ký tự khởi động sẽ được bật cùng bộ cài đặt."
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        <CheckBox Content="Cho phép kiểm tra cập nhật (tùy chọn)"
                                                  IsChecked="{Binding Privacy.UpdateCheckEnabled}" Margin="0,8,0,0" />
                                        <TextBlock Text="Khi bật, EduFocus chỉ gửi số phiên bản ứng dụng tới GitHub Releases; GitHub thấy địa chỉ IP của bạn. Không có dữ liệu học tập, tên máy hay nội dung màn hình nào được gửi, và EduFocus không tự kiểm tra khi khởi động."
                                                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Giao diện" Style="{StaticResource CaptionText}" />
                                                <ComboBox SelectedIndex="{Binding Privacy.ThemeIndex, Mode=TwoWay}"
                                                          Margin="0,4,0,0">
                                                    <ComboBoxItem Content="Tối (mặc định)" />
                                                    <ComboBoxItem Content="Sáng" />
                                                    <ComboBoxItem Content="Theo hệ thống" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ngôn ngữ" Style="{StaticResource CaptionText}" />
                                                <ComboBox SelectedIndex="{Binding Privacy.LanguageIndex, Mode=TwoWay}"
                                                          Margin="0,4,0,0">
                                                    <ComboBoxItem Content="Tiếng Việt" />
                                                    <ComboBoxItem Content="English" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Theme và ngôn ngữ được lưu ngay; giao diện hiện tại chưa có bộ đổi theme/bản dịch động nên thay đổi sẽ hiển thị ở bản hỗ trợ."
                                                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="Lưu cài đặt" Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,0" Command="{Binding Privacy.SaveCommand}"
                                                    IsEnabled="{Binding Privacy.IsNotBusy}" />
                                            <Button Content="Làm mới" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding Privacy.RefreshCommand}"
                                                    IsEnabled="{Binding Privacy.IsNotBusy}" />
                                        </WrapPanel>

                                        <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                                                     Visibility="{Binding Privacy.IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Privacy.SettingsMessage}" Margin="0,10,0,0"
                                                   FontSize="12.5" TextWrapping="Wrap"
                                                   Visibility="{Binding Privacy.HasSettingsMessage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Privacy.SettingsIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Tài khoản phụ huynh" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="PIN bảo vệ mọi thay đổi trong Parent Mode và việc xóa dữ liệu."
                                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                            <Button Content="Đổi PIN phụ huynh" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,16,0,0"
                                                    Command="{Binding OpenChangePinCommand}" />
                                            <Button Content="Khóa phiên" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Command="{Binding LockSessionCommand}" />
                                            <TextBlock Text="Mã khôi phục đã cấp khi thiết lập có thể dùng để đặt lại PIN nếu bạn quên."
                                                       Style="{StaticResource CaptionText}" Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Border Padding="16" CornerRadius="14"
                                                    Background="{StaticResource DangerSoftBrush}"
                                                    BorderBrush="#F3C7C3" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Xóa toàn bộ dữ liệu học tập" FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                    <TextBlock Text="Xóa vĩnh viễn các phiên đã kết thúc, mẫu hoạt động, sự kiện tập trung và lịch sử chặn trên máy này. Không thể hoàn tác. Phiên đang hoạt động, cài đặt, PIN và audit được giữ lại."
                                                               Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />

                                                    <TextBlock Text="Nhập PIN phụ huynh"
                                                               Style="{StaticResource FieldLabelText}" />
                                                    <PasswordBox x:Name="PrivacyDeletePinBox" MaxLength="8"
                                                                 PasswordChanged="PrivacyDeletePinBox_OnPasswordChanged" />

                                                    <TextBlock Text="Gõ XÓA để xác nhận"
                                                               Style="{StaticResource FieldLabelText}" />
                                                    <TextBox Text="{Binding Privacy.DeleteConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="8" />

                                                    <Button Content="Xóa vĩnh viễn dữ liệu học tập"
                                                            Style="{StaticResource DangerButton}"
                                                            Margin="0,16,0,0"
                                                            Command="{Binding Privacy.DeleteAllCommand}"
                                                            IsEnabled="{Binding Privacy.IsNotBusy}" />
                                                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                                                                 Visibility="{Binding Privacy.IsDeleting, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Privacy.DeleteMessage}" Margin="0,10,0,0"
                                                               FontSize="12.5" TextWrapping="Wrap"
                                                               Visibility="{Binding Privacy.HasDeleteMessage, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Privacy.DeleteIsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       FontSize="12.5" MinHeight="18" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    MinWidth="96" Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
