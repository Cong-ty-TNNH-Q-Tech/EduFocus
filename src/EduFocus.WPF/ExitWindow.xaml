<Window x:Class="EduFocus.WPF.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thoát EduFocus"
        Height="440" Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5B6270" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="SecretBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#C9CEDB" />
        </Style>
        <Style x:Key="ExitButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="#D92D20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Thoát EduFocus" FontSize="24" FontWeight="SemiBold" Foreground="#1F2430" />
            <TextBlock Text="Ứng dụng chỉ đóng khi có PIN phụ huynh."
                       FontSize="13" Foreground="#5B6270" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="20" CornerRadius="12"
                Background="White" BorderBrush="#E1E4EC" BorderThickness="1">
            <StackPanel>
                <Border Padding="12" CornerRadius="8" Background="#FEF3F2"
                        BorderBrush="#FECDCA" BorderThickness="1"
                        Visibility="{Binding ProtectionIsOn, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Bảo vệ đang BẬT" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#B42318" />
                        <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#7A271A"
                                   TextWrapping="Wrap"
                                   Text="Thoát EduFocus sẽ tắt bảo vệ, gỡ chặn và kết thúc phiên học đang chạy. Hãy xác nhận bên dưới nếu bạn thực sự muốn thoát." />
                        <CheckBox Content="Tôi hiểu và muốn tắt bảo vệ để thoát"
                                  Margin="0,10,0,0" Foreground="#7A271A"
                                  IsChecked="{Binding ProtectionWarningAccepted}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="PIN phụ huynh" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PinBox" MaxLength="8" Style="{StaticResource SecretBox}"
                             PasswordChanged="PinBox_OnPasswordChanged"
                             KeyDown="PinBox_OnKeyDown" />

                <TextBlock Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#5B6270" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B42318" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Style="{StaticResource CancelButton}"
                    Command="{Binding CancelCommand}" Margin="0,0,10,0" />
            <Button Content="Thoát EduFocus" Style="{StaticResource ExitButton}"
                    Command="{Binding ExitCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
        </StackPanel>
    </Grid>
</Window>
