<Window x:Class="EduFocus.WPF.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thoát EduFocus"
        Height="500" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Center"
                    Background="{StaticResource DangerSoftBrush}">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyph}" FontSize="20"
                           Foreground="{StaticResource DangerBrush}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Thoát EduFocus" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Ứng dụng chỉ đóng khi có PIN phụ huynh."
                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <Border Padding="14" CornerRadius="12"
                        Background="{StaticResource DangerSoftBrush}"
                        BorderBrush="#F3C7C3" BorderThickness="1"
                        Visibility="{Binding ProtectionIsOn, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Bảo vệ đang BẬT" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}"
                                   Foreground="#7A271A"
                                   Text="Thoát EduFocus sẽ tắt bảo vệ, gỡ chặn và kết thúc phiên học đang chạy. Hãy xác nhận bên dưới nếu bạn thực sự muốn thoát." />
                        <CheckBox Content="Tôi hiểu và muốn tắt bảo vệ để thoát"
                                  Margin="0,12,0,0" Foreground="#7A271A"
                                  IsChecked="{Binding ProtectionWarningAccepted}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="PIN phụ huynh" Style="{StaticResource FieldLabelText}" />
                <PasswordBox x:Name="PinBox" MaxLength="8"
                             PasswordChanged="PinBox_OnPasswordChanged"
                             KeyDown="PinBox_OnKeyDown" />

                <TextBlock Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="96" />
            <Button Content="Thoát EduFocus" Style="{StaticResource DangerButton}"
                    Command="{Binding ExitCommand}"
                    IsEnabled="{Binding IsNotBusy}" MinWidth="150" />
        </StackPanel>
    </Grid>
</Window>
