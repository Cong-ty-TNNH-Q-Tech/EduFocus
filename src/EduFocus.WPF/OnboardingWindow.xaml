<Window x:Class="EduFocus.WPF.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduFocus setup" Width="720" Height="580" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" Closing="OnClosing" Loaded="OnLoaded">
    <Grid Margin="36">
        <StackPanel x:Name="WelcomeStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
            <TextBlock Text="Welcome to EduFocus" FontSize="30" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="EduFocus helps a parent support focused study on this computer. Setup is stored locally." Margin="0,20,0,12" TextWrapping="Wrap" FontSize="16" Foreground="#34536F" />
            <TextBlock Text="Camera attention checks estimate whether someone is present and focused. They do not identify a person. Images and video are processed locally and are not saved by the attention analyzer. Website and app blocking depend on Windows permissions and can be bypassed by an administrator." TextWrapping="Wrap" FontSize="15" Foreground="#52677A" />
            <TextBlock Text="You can leave monitoring off. No cloud account or telemetry is required." Margin="0,12,0,28" TextWrapping="Wrap" FontSize="15" Foreground="#52677A" />
            <Button Content="Continue" Height="42" Click="ContinueWelcome" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="PrivacyStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
            <TextBlock Text="Privacy notice" FontSize="30" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="EduFocus stores settings, PIN and recovery hashes, and study summaries in the protected local data folder. If you enable attention monitoring, camera frames are analyzed locally and discarded; they are not written to disk. Technical logs are local and redact credentials and full URLs. The app does not send student data to a server." Margin="0,20,0,18" TextWrapping="Wrap" FontSize="15" Foreground="#52677A" />
            <TextBlock Text="Monitoring and auto-start are off by default. You can change these choices later." TextWrapping="Wrap" FontSize="15" Foreground="#52677A" />
            <CheckBox x:Name="PrivacyAcceptedCheck" Content="I am the parent or guardian and I have read and accept this notice." Margin="0,20,0,12" FontSize="14" AutomationProperties.Name="Accept privacy notice" />
            <TextBlock x:Name="PrivacyStatus" MinHeight="24" Foreground="#9A3412" TextWrapping="Wrap" />
            <Button x:Name="AcceptPrivacyButton" Content="Accept and continue" Height="42" IsEnabled="False" Click="AcceptPrivacy" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="CreatePinStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
            <TextBlock Text="Create a parent PIN" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="Choose 6–8 digits that are not an obvious sequence." Margin="0,14,0,16" Foreground="#52677A" TextWrapping="Wrap" />
            <TextBlock Text="PIN" Margin="0,0,0,5" Foreground="#34536F" />
            <PasswordBox x:Name="CreatePinInput" MaxLength="8" Height="38" FontSize="18" PasswordChar="●" AutomationProperties.Name="Parent PIN" />
            <TextBlock Text="Confirm PIN" Margin="0,12,0,5" Foreground="#34536F" />
            <PasswordBox x:Name="ConfirmPinInput" MaxLength="8" Height="38" FontSize="18" PasswordChar="●" AutomationProperties.Name="Confirm parent PIN" />
            <TextBlock x:Name="CreatePinStatus" Margin="0,10,0,10" MinHeight="30" Foreground="#9A3412" TextWrapping="Wrap" />
            <Button x:Name="CreatePinButton" Content="Create PIN" Height="42" Click="CreatePin" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="ResumePinStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <TextBlock Text="Continue setup" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="A PIN was saved before setup stopped. Verify it to create a fresh recovery code; any code from the unfinished step will be replaced." Margin="0,14,0,16" Foreground="#52677A" TextWrapping="Wrap" />
            <PasswordBox x:Name="ResumePinInput" MaxLength="8" Height="38" FontSize="18" PasswordChar="●" AutomationProperties.Name="Existing parent PIN" />
            <TextBlock x:Name="ResumePinStatus" Margin="0,10,0,10" MinHeight="30" Foreground="#9A3412" TextWrapping="Wrap" />
            <Button x:Name="ResumePinButton" Content="Verify PIN and continue" Height="42" Click="ResumePin" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="RecoveryCodeStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <TextBlock Text="Save your recovery code" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="This code is shown once. Store it somewhere private and separate from this computer. Anyone with it can reset the parent PIN." Margin="0,14,0,18" Foreground="#52677A" TextWrapping="Wrap" />
            <TextBox x:Name="RecoveryCodeText" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold" TextAlignment="Center" Padding="8" AutomationProperties.Name="One-time recovery code" />
            <Button Content="Copy recovery code" Margin="0,12,0,0" Height="38" Click="CopyRecoveryCode" />
            <TextBlock x:Name="CopyStatus" MinHeight="22" Margin="0,4,0,4" Foreground="#52677A" TextWrapping="Wrap" />
            <CheckBox x:Name="RecoverySavedCheck" Content="I saved this recovery code in a private place." Margin="0,12,0,14" FontSize="14" AutomationProperties.Name="Confirm recovery code saved" />
            <Button x:Name="ContinueRecoveryButton" Content="Continue" Height="42" IsEnabled="False" Click="ContinueRecovery" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="PreferencesStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <TextBlock Text="Choose study settings" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="Monitoring and auto-start are optional and off by default. Camera access is checked only when you test a selected camera. No frame is stored." Margin="0,14,0,12" Foreground="#52677A" TextWrapping="Wrap" />
            <CheckBox x:Name="MonitoringCheck" Content="Enable attention monitoring" Margin="0,8,0,8" FontSize="15" AutomationProperties.Name="Enable attention monitoring" />
            <TextBlock Text="Camera" Margin="0,8,0,4" Foreground="#34536F" />
            <ComboBox x:Name="CameraCombo" Height="34" AutomationProperties.Name="Select camera" />
            <Button x:Name="TestCameraButton" Content="Check camera access" Margin="0,8,0,4" Height="36" Click="TestCamera" />
            <TextBlock x:Name="CameraStatus" MinHeight="28" Foreground="#52677A" TextWrapping="Wrap" />
            <CheckBox x:Name="AutoStartCheck" Content="Start EduFocus when I sign in to Windows" Margin="0,12,0,6" FontSize="15" AutomationProperties.Name="Start EduFocus with Windows" />
            <TextBlock Text="Auto-start is registered during final setup. EduFocus requires administrator permission to protect its local data." FontSize="12" Foreground="#52677A" TextWrapping="Wrap" />
            <TextBlock x:Name="PreferencesStatus" Margin="0,8,0,8" MinHeight="24" Foreground="#9A3412" TextWrapping="Wrap" />
            <Button x:Name="FinishSetupButton" Content="Finish setup" Height="42" Click="FinishSetup" />
            <Button Content="Cancel setup" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>

        <StackPanel x:Name="PausedStep" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
            <TextBlock Text="Setup is not finished" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="EduFocus remains locked until the required setup steps are complete. Your completed steps are saved, and you can resume setup the next time you open the app." Margin="0,16,0,22" Foreground="#52677A" TextWrapping="Wrap" />
            <Button Content="Resume setup" Height="42" Click="ResumeSetup" />
            <Button Content="Exit EduFocus" Margin="0,8,0,0" Height="36" Click="CancelSetup" />
        </StackPanel>
    </Grid>
</Window>
