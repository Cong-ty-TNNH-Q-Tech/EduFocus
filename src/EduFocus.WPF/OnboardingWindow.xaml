<Window x:Class="EduFocus.WPF.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập EduFocus"
        Height="780" Width="760"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F9"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2430" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#4B5363" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CBD1DD" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1F2430" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxLength" Value="8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="EduFocus" FontSize="28" FontWeight="SemiBold" Foreground="#1F2430" />
                <TextBlock Text="Thiết lập lần đầu trên máy này"
                           FontSize="13" Foreground="#5B6270" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StepLabel}"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       Foreground="#3D5AFE" />
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="14"
                BorderBrush="#E1E4EC" BorderThickness="1" Padding="30,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Đang chuẩn bị..." Style="{StaticResource StepTitle}" />
                        <TextBlock Text="EduFocus đang kiểm tra dữ liệu cục bộ và tiến trình thiết lập trước đó."
                                   Style="{StaticResource BodyText}" />
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,22,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Không thể khởi động thiết lập" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="Ứng dụng cần quyền ghi vào thư mục dữ liệu được bảo vệ. Hãy chạy EduFocus với quyền quản trị, sau đó thử lại."
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button x:Name="RetryButton" Content="Thử lại" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" IsDefault="True"
                                    Command="{Binding LoadCommand}" />
                            <Button Content="Thoát" Style="{StaticResource QuietButton}" Margin="14,0,0,0"
                                    Command="{Binding ExitCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Chào mừng đến với EduFocus" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="EduFocus giúp phụ huynh và học sinh hiểu rõ thời gian học tập trên máy tính. Trước khi bắt đầu, hãy xem phạm vi và giới hạn của ứng dụng." />

                        <TextBlock Style="{StaticResource BodyText}" Margin="0,18,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Dữ liệu học tập được lưu trên chính máy này, không tải lên đám mây." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Camera chỉ được dùng để ước lượng trạng thái tập trung; EduFocus không lưu ảnh, video hay nhận diện danh tính." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Đây là công cụ hỗ trợ, không phải thiết bị theo dõi chính xác. Webcam không thay thế eye tracker hồng ngoại." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Chặn web là best-effort; VPN, DoH hoặc thay đổi hệ thống có thể vượt qua." />
                        </TextBlock>

                        <Border Background="#F7F8FC" BorderBrush="#E1E4EC" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,20,0,0">
                            <TextBlock Style="{StaticResource BodyText}" Margin="0"
                                       Text="EduFocus được giới thiệu công khai với học sinh. Phụ huynh chịu trách nhiệm về sự đồng thuận trong gia đình." />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Thoát" Style="{StaticResource QuietButton}" Margin="0,0,12,0"
                                    Command="{Binding ExitCommand}" />
                            <Button x:Name="WelcomeContinueButton" Content="Tiếp tục"
                                    Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Command="{Binding ContinueWelcomeCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPrivacyVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Quyền riêng tư và sự đồng thuận" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="EduFocus chỉ xử lý dữ liệu trên máy này. Không có tài khoản đám mây, không gửi dữ liệu qua mạng và không lưu hình ảnh." />

                        <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Dữ liệu gồm trạng thái tập trung ước lượng, phiên học và sự kiện chặn — được giữ theo thời hạn cấu hình và có thể xóa." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="EduFocus không phân tích cảm xúc, không nhận diện danh tính và không chia sẻ dữ liệu với bên thứ ba." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="• " FontWeight="Bold" Foreground="#3D5AFE" />
                            <Run Text="Phụ huynh có thể xem và xóa dữ liệu trong Parent Mode sau khi thiết lập." />
                        </TextBlock>

                        <CheckBox x:Name="PrivacyCheckBox"
                                  IsChecked="{Binding PrivacyAccepted, Mode=TwoWay}"
                                  AutomationProperties.Name="Tôi đã đọc thông báo quyền riêng tư"
                                  Content="Tôi đã đọc và hiểu thông báo quyền riêng tư của EduFocus." />
                        <CheckBox IsChecked="{Binding GuardianAcknowledged, Mode=TwoWay}"
                                  AutomationProperties.Name="Tôi đã thông báo cho học sinh về việc giám sát"
                                  Content="Tôi đã thông báo cho học sinh về phạm vi giám sát và nhận được sự đồng ý trong gia đình." />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Thoát" Style="{StaticResource QuietButton}" Margin="0,0,12,0"
                                    Command="{Binding ExitCommand}" />
                            <Button Content="Tiếp tục" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    IsEnabled="{Binding CanContinuePrivacy}"
                                    Command="{Binding ContinuePrivacyCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPreferencesVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tuỳ chọn an toàn" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Các giá trị mặc định ưu tiên bảo vệ nhưng không khóa máy. Bạn có thể thay đổi sau trong Parent Mode." />

                        <CheckBox x:Name="MonitoringCheckBox"
                                  IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Bật giám sát tập trung bằng camera"
                                  Content="Bật giám sát tập trung bằng camera khi phiên học bắt đầu" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="24,4,0,0"
                                   Text="Camera chỉ được mở trong phiên học và tắt khi phiên kết thúc. Không có ảnh hay video nào được ghi lại." />

                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  AutomationProperties.Name="Khởi động cùng Windows"
                                  Content="Ưu tiên khởi động cùng Windows khi đăng nhập" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="24,4,0,0"
                                   Text="Tuỳ chọn này được lưu lại và áp dụng khi tính năng bảo vệ nền hoàn thiện." />

                        <Border Margin="0,20,0,0" Padding="14" CornerRadius="8"
                                Background="#F7F8FC" BorderBrush="#E1E4EC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Quyền camera" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#1F2430" />
                                <TextBlock Text="{Binding CameraStatusText}" Style="{StaticResource BodyText}"
                                           Margin="0,6,0,0" />
                                <Button Content="Kiểm tra lại" Style="{StaticResource QuietButton}"
                                        Margin="0,10,0,0" Command="{Binding CheckCameraCommand}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Tiếp tục" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Command="{Binding ContinuePreferencesCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPinVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tạo PIN phụ huynh" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="PIN bảo vệ các thao tác nhạy cảm như tắt bảo vệ, đổi lịch hoặc xóa dữ liệu. Hãy chọn PIN mà học sinh không dễ đoán." />

                        <Label Content="PIN (6–8 chữ số)" Target="{Binding ElementName=PinBox}" Margin="0,18,0,0" />
                        <PasswordBox x:Name="PinBox"
                                     AutomationProperties.Name="PIN phụ huynh"
                                     PasswordChanged="PinBox_OnPasswordChanged"
                                     KeyDown="PinBox_OnKeyDown" />

                        <Label Content="Nhập lại PIN" Target="{Binding ElementName=ConfirmPinBox}" Margin="0,12,0,0" />
                        <PasswordBox x:Name="ConfirmPinBox"
                                     AutomationProperties.Name="Nhập lại PIN phụ huynh"
                                     PasswordChanged="ConfirmPinBox_OnPasswordChanged"
                                     KeyDown="PinBox_OnKeyDown" />

                        <TextBlock Style="{StaticResource BodyText}" Margin="0,14,0,0"
                                   Foreground="#6B7280"
                                   Text="PIN phải có 6–8 chữ số, không lặp lại một chữ số và không tăng/giảm liên tiếp. EduFocus chỉ lưu hash PBKDF2 của PIN." />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Tạo PIN" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Command="{Binding ConfigurePinCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsResumePinVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tiếp tục thiết lập" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="PIN đã được tạo trước khi ứng dụng đóng giữa chừng. Vì mã khôi phục chỉ hiển thị một lần, hãy xác nhận PIN để tạo mã mới." />

                        <Label Content="PIN phụ huynh" Target="{Binding ElementName=ResumePinBox}" Margin="0,18,0,0" />
                        <PasswordBox x:Name="ResumePinBox"
                                     AutomationProperties.Name="PIN phụ huynh để tiếp tục thiết lập"
                                     PasswordChanged="ResumePinBox_OnPasswordChanged"
                                     KeyDown="ResumePinBox_OnKeyDown" />

                        <TextBlock Style="{StaticResource BodyText}" Margin="0,14,0,0"
                                   Text="Mã khôi phục cũ (nếu có) sẽ bị vô hiệu. Mã mới chỉ hiển thị một lần." />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Xác nhận" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Command="{Binding ResumeWithPinCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRecoveryCodeVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Lưu mã khôi phục" Style="{StaticResource StepTitle}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Mã này dùng để đặt lại PIN nếu bạn quên. Mã chỉ hiển thị một lần và EduFocus không thể xem lại hoặc khôi phục mã đã lưu hash." />

                        <TextBox x:Name="RecoveryCodeBox"
                                 Text="{Binding IssuedRecoveryCode, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="Mã khôi phục"
                                 FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                                 TextAlignment="Center" Padding="12"
                                 Margin="0,18,0,0" BorderBrush="#CBD1DD" BorderThickness="1" />

                        <Button Content="Sao chép mã" Style="{StaticResource QuietButton}" Margin="0,10,0,0"
                                Command="{Binding CopyRecoveryCodeCommand}" />

                        <Border Background="#FFF8E6" BorderBrush="#E7C56A" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource BodyText}" Margin="0"
                                       Text="Hãy lưu mã ở nơi an toàn, không chia sẻ với học sinh hoặc người khác. Nếu mất mã, bạn vẫn có thể dùng PIN hiện tại để tạo mã mới trong Parent Mode." />
                        </Border>

                        <CheckBox IsChecked="{Binding RecoveryCodeSaved, Mode=TwoWay}"
                                  AutomationProperties.Name="Tôi đã lưu mã khôi phục"
                                  Content="Tôi đã lưu mã khôi phục ở nơi an toàn." />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button x:Name="FinishButton" Content="Hoàn tất" Style="{StaticResource PrimaryButton}"
                                    IsDefault="True" IsEnabled="{Binding CanFinish}"
                                    Command="{Binding FinishCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,20,0,0"
                               FontSize="13" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#5B6270" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#B42318" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Margin="4,14,4,0" FontSize="12" Foreground="#8A909C"
                   TextWrapping="Wrap"
                   Text="Dữ liệu được lưu trên máy này. Bạn có thể đóng cửa sổ và tiếp tục thiết lập ở lần mở tiếp theo." />
    </Grid>
</Window>
