<Window x:Class="EduFocus.WPF.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập EduFocus"
        Height="780" Width="1020"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand / progress panel -->
        <Border Grid.Column="0" CornerRadius="26" Background="{StaticResource OnboardingGradientBrush}">
            <Grid>
                <Ellipse Width="260" Height="260" Fill="#12FFFFFF"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-90,0" />
                <Ellipse Width="180" Height="180" Fill="#0FFFFFFF"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-70,0,0,-50" />

                <Grid Margin="28,30,28,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="13" Background="#28FFFFFF">
                                <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="EduFocus" FontSize="22" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Học tập tập trung bắt đầu từ hôm nay."
                                   FontSize="25" FontWeight="Bold" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,28,0,0" LineHeight="33" />
                        <TextBlock Text="Thiết lập nhanh vài bước để cả gia đình cùng hiểu cách EduFocus đồng hành."
                                   FontSize="13" Foreground="#E4E0FF" TextWrapping="Wrap"
                                   Margin="0,10,0,0" LineHeight="20" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Background="#1FFFFFFF" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="TIẾN ĐỘ THIẾT LẬP" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#CFC9FF" />
                                <TextBlock Text="{Binding StepLabel}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,6,0,0" />
                                <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding StepProgress, Mode=OneWay}"
                                             Background="#33FFFFFF"
                                             Foreground="White" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="2,24,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="#DCD7FF" />
                                <TextBlock Text="Dữ liệu ở lại trên máy này" Margin="10,0,0,0"
                                           FontSize="12.5" Foreground="#EFEDFF" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="&#xE722;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="#DCD7FF" />
                                <TextBlock Text="Không lưu ảnh hay video camera" Margin="10,0,0,0"
                                           FontSize="12.5" Foreground="#EFEDFF" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="#DCD7FF" />
                                <TextBlock Text="Phụ huynh nắm quyền kiểm soát" Margin="10,0,0,0"
                                           FontSize="12.5" Foreground="#EFEDFF" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="EduFocus 2.0 · Windows 10/11"
                               FontSize="11" Foreground="#CFC9FF" />
                </Grid>
            </Grid>
        </Border>

        <!-- Step content -->
        <Grid Grid.Column="1" Margin="38,26,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="THIẾT LẬP LẦN ĐẦU" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Border Width="4" Height="4" CornerRadius="2" Background="{StaticResource BorderStrongBrush}"
                        VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Text="An toàn cho học sinh, minh bạch cho phụ huynh"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- Loading -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource PrimarySoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Đang chuẩn bị..." Style="{StaticResource PageTitleText}" Margin="0,18,0,0" />
                        <TextBlock Text="EduFocus đang kiểm tra dữ liệu cục bộ và tiến trình thiết lập trước đó."
                                   Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,26,0,0" />
                    </StackPanel>

                    <!-- Error -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource DangerSoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Không thể khởi động thiết lập" Style="{StaticResource PageTitleText}"
                                   Margin="0,18,0,0" />
                        <TextBlock Text="Ứng dụng cần quyền ghi vào thư mục dữ liệu được bảo vệ. Hãy chạy EduFocus với quyền quản trị, sau đó thử lại."
                                   Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="12" Padding="14"
                                Margin="0,18,0,0">
                            <TextBlock Text="Mẹo: nhấp chuột phải vào EduFocus và chọn “Run as administrator”."
                                       FontSize="12.5" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel Margin="0,24,0,0">
                            <Button x:Name="RetryButton" Content="Thử lại" Style="{StaticResource PrimaryButton}"
                                    IsDefault="True" Margin="0,0,10,8"
                                    Command="{Binding LoadCommand}" />
                            <Button Content="Thoát" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,8" Command="{Binding ExitCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Welcome -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource PrimarySoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="27"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Chào mừng đến với EduFocus" Style="{StaticResource PageTitleText}"
                                   Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="EduFocus giúp phụ huynh và học sinh hiểu rõ thời gian học tập trên máy tính. Trước khi bắt đầu, cả nhà cùng xem phạm vi và giới hạn của ứng dụng." />

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,20,0,0" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{StaticResource PrimaryBrush}" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Chỉ lưu trên máy này" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="Không có tài khoản đám mây, không gửi dữ liệu học tập qua mạng."
                                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{StaticResource TealSoftBrush}">
                                        <TextBlock Text="&#xE722;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{StaticResource TealBrush}" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Camera không ghi hình" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="Chỉ ước lượng trạng thái tập trung trong phiên học; không lưu ảnh, video hay nhận diện danh tính."
                                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{StaticResource WarningSoftBrush}">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{StaticResource WarningBrush}" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Phụ huynh đồng hành" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="PIN phụ huynh bảo vệ các thay đổi quan trọng và dữ liệu của học sinh."
                                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{StaticResource SurfaceBrush}">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Chặn web là best-effort" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="VPN, DoH hoặc thay đổi hệ thống có thể vượt qua. Đây là công cụ hỗ trợ, không phải thiết bị theo dõi tuyệt đối."
                                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF9E8" BorderBrush="#F3D48A" BorderThickness="1"
                                CornerRadius="12" Padding="14" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0"
                                       Foreground="#8A5A00"
                                       Text="Phụ huynh chịu trách nhiệm trao đổi và nhận sự đồng thuận trong gia đình trước khi bật giám sát." />
                        </Border>

                        <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Thoát" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"
                                    Command="{Binding ExitCommand}" />
                            <Button x:Name="WelcomeContinueButton" Content="Tiếp tục"
                                    Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,0,8"
                                    Command="{Binding ContinueWelcomeCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Privacy -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                Visibility="{Binding IsPrivacyVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource TealSoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource TealBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Quyền riêng tư và sự đồng thuận" Style="{StaticResource PageTitleText}"
                                   Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="EduFocus chỉ xử lý dữ liệu trên máy này. Không có tài khoản đám mây, không gửi dữ liệu qua mạng và không lưu hình ảnh." />

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,18,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0">
                                    <Run Text="• " FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <Run Text="Dữ liệu gồm trạng thái tập trung ước lượng, phiên học và sự kiện chặn — được giữ theo thời hạn cấu hình và có thể xóa." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0">
                                    <Run Text="• " FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <Run Text="Không phân tích cảm xúc, không nhận diện danh tính và không chia sẻ với bên thứ ba." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0">
                                    <Run Text="• " FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <Run Text="Phụ huynh có thể xem và xóa dữ liệu trong Parent Mode sau khi thiết lập." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Xem thông báo quyền riêng tư đầy đủ"
                                Style="{StaticResource LinkButton}" Margin="0,14,0,0"
                                Click="OpenPrivacyNotice_OnClick" />

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,16,0,0" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="PrivacyCheckBox"
                                          IsChecked="{Binding PrivacyAccepted, Mode=TwoWay}"
                                          AutomationProperties.Name="Tôi đã đọc thông báo quyền riêng tư"
                                          Content="Tôi đã đọc và hiểu thông báo quyền riêng tư của EduFocus." />
                                <CheckBox IsChecked="{Binding GuardianAcknowledged, Mode=TwoWay}"
                                          Margin="0,12,0,0"
                                          AutomationProperties.Name="Tôi đã thông báo cho học sinh về việc giám sát"
                                          Content="Tôi đã thông báo cho học sinh về phạm vi giám sát và nhận được sự đồng ý trong gia đình." />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Right">
                            <Button Content="Thoát" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"
                                    Command="{Binding ExitCommand}" />
                            <Button Content="Tiếp tục" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding CanContinuePrivacy}"
                                    Command="{Binding ContinuePrivacyCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Safe preferences -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                Visibility="{Binding IsPreferencesVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource PrimarySoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tuỳ chọn an toàn" Style="{StaticResource PageTitleText}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="Các giá trị mặc định ưu tiên bảo vệ nhưng không khóa máy. Phụ huynh có thể thay đổi sau trong Parent Mode." />

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,18,0,0" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="MonitoringCheckBox"
                                          IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="Bật giám sát tập trung bằng camera"
                                          Content="Bật giám sát tập trung bằng camera khi phiên học bắt đầu" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="30,6,0,0"
                                           Text="Camera chỉ được mở trong phiên học và tắt khi phiên kết thúc. Không có ảnh hay video nào được ghi lại." />
                                <Button Content="Xem lại thông báo quyền riêng tư"
                                        Style="{StaticResource LinkButton}" Margin="30,8,0,0"
                                        Click="OpenPrivacyNotice_OnClick" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          AutomationProperties.Name="Khởi động cùng Windows"
                                          Content="Ưu tiên khởi động cùng Windows khi đăng nhập" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="30,6,0,0"
                                           Text="Tuỳ chọn này được lưu lại và áp dụng khi tính năng bảo vệ nền hoàn thiện." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,12,0,0" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="11"
                                        Background="{StaticResource TealSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE722;" Style="{StaticResource IconGlyph}" FontSize="16"
                                               Foreground="{StaticResource TealBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Kiểm tra camera" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{Binding CameraStatusText}" Style="{StaticResource SecondaryText}"
                                               Margin="0,4,0,0" />
                                    <Button Content="Kiểm tra lại" Style="{StaticResource LinkButton}"
                                            Margin="0,8,0,0" Command="{Binding CheckCameraCommand}"
                                            IsEnabled="{Binding CanCheckCamera}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="Tiếp tục" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                HorizontalAlignment="Right" Margin="0,24,0,8"
                                Command="{Binding ContinuePreferencesCommand}" />
                    </StackPanel>

                    <!-- PIN -->
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left"
                                Visibility="{Binding IsPinVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource PrimarySoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tạo PIN phụ huynh" Style="{StaticResource PageTitleText}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="PIN bảo vệ các thao tác nhạy cảm như tắt bảo vệ, đổi lịch hoặc xóa dữ liệu. Hãy chọn PIN mà học sinh không dễ đoán." />

                        <Label Content="PIN (6–8 chữ số)" Target="{Binding ElementName=PinBox}" Margin="0,22,0,6" />
                        <PasswordBox x:Name="PinBox" MaxLength="8"
                                     AutomationProperties.Name="PIN phụ huynh"
                                     PasswordChanged="PinBox_OnPasswordChanged"
                                     KeyDown="PinBox_OnKeyDown" />

                        <Label Content="Nhập lại PIN" Target="{Binding ElementName=ConfirmPinBox}" Margin="0,14,0,6" />
                        <PasswordBox x:Name="ConfirmPinBox" MaxLength="8"
                                     AutomationProperties.Name="Nhập lại PIN phụ huynh"
                                     PasswordChanged="ConfirmPinBox_OnPasswordChanged"
                                     KeyDown="PinBox_OnKeyDown" />

                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12"
                                Padding="14" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           Text="PIN phải có 6–8 chữ số, không lặp lại một chữ số và không tăng/giảm liên tiếp. EduFocus chỉ lưu hash PBKDF2 của PIN." />
                            </StackPanel>
                        </Border>

                        <Button Content="Tạo PIN" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                HorizontalAlignment="Right" Margin="0,24,0,8"
                                Command="{Binding ConfigurePinCommand}" />
                    </StackPanel>

                    <!-- Resume PIN -->
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left"
                                Visibility="{Binding IsResumePinVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource WarningSoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tiếp tục thiết lập" Style="{StaticResource PageTitleText}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="PIN đã được tạo trước khi ứng dụng đóng giữa chừng. Vì mã khôi phục chỉ hiển thị một lần, hãy xác nhận PIN để tạo mã mới." />

                        <Label Content="PIN phụ huynh" Target="{Binding ElementName=ResumePinBox}" Margin="0,22,0,6" />
                        <PasswordBox x:Name="ResumePinBox" MaxLength="8"
                                     AutomationProperties.Name="PIN phụ huynh để tiếp tục thiết lập"
                                     PasswordChanged="ResumePinBox_OnPasswordChanged"
                                     KeyDown="ResumePinBox_OnKeyDown" />

                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,14,0,0"
                                   Text="Mã khôi phục cũ (nếu có) sẽ bị vô hiệu. Mã mới chỉ hiển thị một lần." />

                        <Button Content="Xác nhận" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                HorizontalAlignment="Right" Margin="0,24,0,8"
                                Command="{Binding ResumeWithPinCommand}" />
                    </StackPanel>

                    <!-- Recovery code -->
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left"
                                Visibility="{Binding IsRecoveryCodeVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource SuccessSoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Lưu mã khôi phục" Style="{StaticResource PageTitleText}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="Mã này dùng để đặt lại PIN nếu phụ huynh quên. Mã chỉ hiển thị một lần và EduFocus không thể xem lại hoặc khôi phục mã đã lưu hash." />

                        <TextBox x:Name="RecoveryCodeBox"
                                 Text="{Binding IssuedRecoveryCode, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="Mã khôi phục"
                                 FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                                 TextAlignment="Center" Padding="14,12"
                                 Background="{StaticResource PrimarySoftBrush}"
                                 BorderBrush="{StaticResource PrimaryBrush}"
                                 Margin="0,20,0,0" />

                        <Button Content="Sao chép mã" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding CopyRecoveryCodeCommand}" />

                        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#F3D48A"
                                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0" Foreground="#8A5A00"
                                       Text="Hãy lưu mã ở nơi an toàn, không chia sẻ với học sinh hoặc người khác. Nếu mất mã, phụ huynh vẫn có thể dùng PIN hiện tại để tạo mã mới trong Parent Mode." />
                        </Border>

                        <CheckBox IsChecked="{Binding RecoveryCodeSaved, Mode=TwoWay}" Margin="0,16,0,0"
                                  AutomationProperties.Name="Tôi đã lưu mã khôi phục"
                                  Content="Tôi đã lưu mã khôi phục ở nơi an toàn." />

                        <Button x:Name="FinishButton" Content="Hoàn tất" Style="{StaticResource PrimaryButton}"
                                IsDefault="True" IsEnabled="{Binding CanFinish}"
                                HorizontalAlignment="Right" Margin="0,24,0,8"
                                Command="{Binding FinishCommand}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,12,0,0"
                       MinHeight="20" FontSize="12.5" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
