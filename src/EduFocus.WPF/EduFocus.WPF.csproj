<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Version is injected by CI from git tag, e.g. 1.2.3 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>EduFocus</AssemblyName>
    <Product>EduFocus</Product>
    <Copyright>Copyright © 2026 ThanhTrunggDEV</Copyright>
    <!-- Debug: asInvoker → dotnet run works without elevation -->
    <!-- Release: requireAdministrator → UAC auto-prompt on launch -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduFocus.Ports\EduFocus.Ports.csproj" />
    <ProjectReference Include="..\EduFocus.Infrastructure\EduFocus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
