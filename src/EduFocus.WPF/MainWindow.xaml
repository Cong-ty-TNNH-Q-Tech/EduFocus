<Window x:Class="EduFocus.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduFocus"
        Width="760" Height="480"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock Text="EduFocus" FontSize="36" FontWeight="SemiBold"
                       Foreground="#17324D" HorizontalAlignment="Center" />
            <TextBlock Text="Nền tảng phiên bản 2.0"
                       FontSize="20" Margin="0,12,0,0"
                       Foreground="#34536F" HorizontalAlignment="Center" />
            <TextBlock Text="Các tính năng sẽ được triển khai theo lộ trình sản phẩm."
                       FontSize="14" Margin="0,16,0,0" TextWrapping="Wrap"
                       Foreground="#52677A" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>