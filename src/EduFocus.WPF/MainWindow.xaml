<Window x:Class="EduFocus.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduFocus"
        Height="800" Width="1160"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Style="{StaticResource SidebarSurface}" Margin="0,0,18,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,0">
                    <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource HeroGradientBrush}">
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12,3.5 L 2,8.5 L 12,13.5 L 22,8.5 Z"
                                      Stroke="White" StrokeThickness="1.9"
                                      StrokeLineJoin="Round" Fill="#26FFFFFF" />
                                <Path Data="M 6,10.8 L 6,16.2 C 6,18.2 8.7,19.8 12,19.8 C 15.3,19.8 18,18.2 18,16.2 L 18,10.8"
                                      Stroke="White" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path Data="M 21,8.8 L 21,15.5"
                                      Stroke="White" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EduFocus" FontSize="19.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Không gian học tập" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <TextBlock Text="KHÔNG GIAN CỦA BẠN" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="13,0,0,8" />
                    <ListBox x:Name="SectionNav" Style="{StaticResource SidebarNavList}"
                             SelectedIndex="0">
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3,10.5 L 12,3 L 21,10.5 L 21,20 C 21,20.6 20.6,21 20,21 L 15,21 L 15,14.5 L 9,14.5 L 9,21 L 4,21 C 3.4,21 3,20.6 3,20 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Tổng quan" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 9,18 L 15,18 M 10,21 L 14,21 M 12,3 C 8.1,3 5,6.1 5,10 C 5,12.4 6.2,14.5 8,15.7 L 8,17 C 8,17.6 8.4,18 9,18 L 15,18 C 15.6,18 16,17.6 16,17 L 16,15.7 C 17.8,14.5 19,12.4 19,10 C 19,6.1 15.9,3 12,3 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Mẹo học tập" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2.5 L 19.5,5.8 L 19.5,11.5 C 19.5,16.5 16.3,20.2 12,21.5 C 7.7,20.2 4.5,16.5 4.5,11.5 L 4.5,5.8 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeLineJoin="Round" />
                                        <Path Data="M 9,12 L 11,14 L 15.2,9.8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Cài đặt &amp; riêng tư" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="5.5" Canvas.Top="4" Width="7" Height="7"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 StrokeThickness="2" />
                                        <Path Data="M 2.5,20 C 2.5,16.4 5.4,13.8 9,13.8 C 12.6,13.8 15.5,16.4 15.5,20"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M 16,4.5 C 18.2,5.1 19.5,7.2 19,9.5 C 18.6,11.1 17.4,12.2 15.8,12.5 M 21.5,20 C 21.5,17.2 19.6,14.8 17,14.1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Về chúng tôi" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- Camera status -->
                <Border Grid.Row="3" Style="{StaticResource SoftCardBorder}" Padding="13,12" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 3,8 C 3,6.9 3.9,6 5,6 L 7.5,6 L 9,4 L 15,4 L 16.5,6 L 19,6 C 20.1,6 21,6.9 21,8 L 21,18 C 21,19.1 20.1,20 19,20 L 5,20 C 3.9,20 3,19.1 3,18 Z"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="9" Canvas.Top="10" Width="6" Height="6"
                                             Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Camera đồng hành" Style="{StaticResource CaptionText}" Margin="7,0,0,0"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Ellipse Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding Camera.IndicatorBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Camera.StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Parent entry -->
                <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Margin="0,10,0,4"
                        Padding="14,9" Click="ParentModeButton_Click"
                        ToolTip="Đăng nhập PIN phụ huynh để quản lý các cài đặt được bảo vệ">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 6,11 L 18,11 C 19.1,11 20,11.9 20,13 L 20,19 C 20,20.1 19.1,21 18,21 L 6,21 C 4.9,21 4,20.1 4,19 L 4,13 C 4,11.9 4.9,11 6,11 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                <Path Data="M 8,11 L 8,7.5 C 8,5.1 9.8,3.2 12,3.2 C 14.2,3.2 16,5.1 16,7.5 L 16,11"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Phụ huynh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <TabControl Grid.Column="1" x:Name="SectionPages"
                    Style="{StaticResource ContentOnlyTabControl}"
                    SelectedIndex="{Binding SelectedIndex, ElementName=SectionNav, Mode=TwoWay}">

            <!-- ============================================================
                 TAB 0: OVERVIEW (TỔNG QUAN)
                 ============================================================ -->
            <TabItem FocusVisualStyle="{x:Null}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}"
                              Focusable="False"
                              Padding="4,0,4,4">
                    <StackPanel MaxWidth="1060">

                        <!-- Hero: protection status -->
                        <Border CornerRadius="24" Padding="32,28" Margin="0,0,0,18" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource HeroPausedGradientBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- Ambient decorative background circles -->
                                <Ellipse Width="250" Height="250" Fill="#12FFFFFF"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-105,-80,0" IsHitTestVisible="False" />
                                <Ellipse Width="180" Height="180" Fill="#0CFFFFFF"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="-70,0,0,-75" IsHitTestVisible="False" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,28,0" VerticalAlignment="Center">
                                        <!-- Status Pill -->
                                        <Border Background="#28FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                CornerRadius="999" Padding="13,6"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FFD37A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="True">
                                                                    <Setter Property="Fill" Value="#8CFFC1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="ĐANG BẢO VỆ · KHÔNG GIAN TẬP TRUNG" Margin="8,0,0,0" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="CHƯA BẬT BẢO VỆ · CHẾ ĐỘ TỰ DO" Margin="8,0,0,0" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Headline -->
                                        <TextBlock Margin="0,14,0,0" FontSize="30" FontWeight="Bold"
                                                   Foreground="White" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Text="Bảo vệ đang bật"
                                                   Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,14,0,0" FontSize="30" FontWeight="Bold"
                                                   Foreground="White" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Text="Bảo vệ đang tắt">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Subtitle (left-aligned strictly) -->
                                        <TextBlock Text="{Binding Protection.StatusText}" Margin="0,8,0,0"
                                                   FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Foreground="#EDEBFF" MaxWidth="580" />

                                        <TextBlock Text="{Binding Protection.WarningText}" Margin="0,10,0,0"
                                                   FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Foreground="#FFE4B8"
                                                   Visibility="{Binding Protection.HasWarning, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Metadata pills -->
                                        <WrapPanel Margin="0,18,0,0" HorizontalAlignment="Left">
                                            <Border Background="#24FFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Fill="{Binding Camera.IndicatorBrush}" />
                                                    <TextBlock Text="{Binding Camera.StatusText}" Margin="8,0,0,0"
                                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#F6F5FF"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                                               MaxWidth="420" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#1CFFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 12,2.5 L 19.5,5.8 L 19.5,11.5 C 19.5,16.5 16.3,20.2 12,21.5 C 7.7,20.2 4.5,16.5 4.5,11.5 L 4.5,5.8 Z"
                                                                  Stroke="#E4E0FF" StrokeThickness="2" StrokeLineJoin="Round" />
                                                            <Path Data="M 8.8,12 L 11,14.2 L 15.4,9.8"
                                                                  Stroke="#8CFFC1" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="Xử lý cục bộ 100% · An toàn riêng tư" Margin="7,0,0,0"
                                                               FontSize="12" Foreground="#E4E0FF"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Camera.GuidanceText}" Margin="0,4,0,0"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="#FFE4B8"
                                                   HorizontalAlignment="Left" MaxWidth="560"
                                                   Visibility="{Binding Camera.HasGuidance, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Hero Icon Badge: Perfectly concentric and geometrically centered -->
                                    <Border Grid.Column="1" Width="120" Height="120" CornerRadius="60"
                                            Background="#16FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="88" Height="88" CornerRadius="44"
                                                Background="#24FFFFFF"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Protected state: Shield with Checkmark -->
                                                <Viewbox Width="44" Height="44"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,2.5 L 20,6 L 20,11.5 C 20,16.8 16.5,20.6 12,21.8 C 7.5,20.6 4,16.8 4,11.5 L 4,6 Z"
                                                              Stroke="White" StrokeThickness="2"
                                                              StrokeLineJoin="Round" Fill="#1EFFFFFF" />
                                                        <Path Data="M 8.5,12.2 L 11,14.7 L 15.8,9.8"
                                                              Stroke="#8CFFC1" StrokeThickness="2.3"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Paused / Warning state: Geometrically & Optically Centered Triangle -->
                                                <Viewbox Width="44" Height="44"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Canvas Width="24" Height="24">
                                                        <!-- Symmetric triangle: X from 2.5 to 21.5 (center=12.0), Y from 3.5 to 19.5 -->
                                                        <Path Data="M 12,3.5 L 21.5,19.5 L 2.5,19.5 Z"
                                                              Stroke="#FFE4B8" StrokeThickness="2"
                                                              StrokeLineJoin="Round" Fill="#18FFE4B8" />
                                                        <!-- Exclamation bar on exact X=12.0 axis -->
                                                        <Path Data="M 12,9.5 L 12,14"
                                                              Stroke="#FFE4B8" StrokeThickness="2.2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <!-- Exclamation dot centered at X=12.0 (10.9 + 1.1) -->
                                                        <Ellipse Canvas.Left="10.9" Canvas.Top="16.1"
                                                                 Width="2.2" Height="2.2"
                                                                 Fill="#FFE4B8" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Quick stats (3 student cards) -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Study time -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,3.5 L 2,8.5 L 12,13.5 L 22,8.5 Z"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                      StrokeLineJoin="Round" />
                                                <Path Data="M 6,10.8 L 6,16.2 C 6,18.2 8.7,19.8 12,19.8 C 15.3,19.8 18,18.2 18,16.2 L 18,10.8"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                                <Path Data="M 21,8.8 L 21,15.5"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Thời gian học hôm nay" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding Dashboard.StudyTimeText}" FontSize="21"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Tích lũy trong ngày" FontSize="11"
                                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Stat 2: Sessions -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14"
                                            Background="{StaticResource TealSoftBrush}"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                                         Stroke="{StaticResource TealBrush}" StrokeThickness="2" />
                                                <Path Data="M 12,7.5 L 12,12 L 15.5,14.2"
                                                      Stroke="{StaticResource TealBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Phiên học hôm nay" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding Dashboard.SessionCountText}" FontSize="21"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Số phiên đã ghi nhận" FontSize="11"
                                                   Foreground="{StaticResource TealBrush}" FontWeight="SemiBold"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Stat 3: Camera -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14"
                                            Background="{StaticResource WarningSoftBrush}"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 3,8 C 3,6.9 3.9,6 5,6 L 7.5,6 L 9,4 L 15,4 L 16.5,6 L 19,6 C 20.1,6 21,6.9 21,8 L 21,18 C 21,19.1 20.1,20 19,20 L 5,20 C 3.9,20 3,19.1 3,18 Z"
                                                      Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" />
                                                <Ellipse Canvas.Left="8.8" Canvas.Top="9.8" Width="6.4" Height="6.4"
                                                         Stroke="{StaticResource WarningBrush}" StrokeThickness="2" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Camera AI" Style="{StaticResource CaptionText}" />
                                            <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                                     Fill="{Binding Camera.IndicatorBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Camera.StatusText}" FontSize="14"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Không lưu ảnh hay video" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Today's Study Progress -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="12"
                                                Background="{StaticResource PrimarySoftBrush}">
                                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 5,5 L 19,5 C 20.1,5 21,5.9 21,7 L 21,19 C 21,20.1 20.1,21 19,21 L 5,21 C 3.9,21 3,20.1 3,19 L 3,7 C 3,5.9 3.9,5 5,5 Z"
                                                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                    <Path Data="M 16,3 L 16,7 M 8,3 L 8,7 M 3,10 L 21,10"
                                                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hôm nay của bạn" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="Theo dõi tiến độ học tập và mức độ tập trung trong ngày"
                                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource PillBorder}" Padding="12,6">
                                        <TextBlock Text="{Binding Dashboard.DateLabel}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                                    </Border>
                                </Grid>

                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                                             Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Active / Completed Summary State -->
                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding Dashboard.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="16" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Dashboard.StudentStudyText}" FontSize="22"
                                                       FontWeight="Bold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Dashboard.ActiveSessionText}" Margin="0,6,0,0"
                                                       Style="{StaticResource BodyText}" />
                                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12"
                                                    Padding="14,12" Margin="0,16,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 12,2.5 L 19.5,5.8 L 19.5,11.5 C 19.5,16.5 16.3,20.2 12,21.5 C 7.7,20.2 4.5,16.5 4.5,11.5 L 4.5,5.8 Z"
                                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                            <Path Data="M 9,12 L 11,14 L 15.2,9.8"
                                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                                               Text="Mỗi phiên học đều được ghi nhận riêng trên máy này — không có dữ liệu nào bị gửi lên mạng." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Empty State (Student Readiness Guide) -->
                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding Dashboard.ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="16" Padding="22">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="54" Height="54" CornerRadius="16"
                                                        Background="{StaticResource PrimarySoftBrush}"
                                                        VerticalAlignment="Center">
                                                    <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 12,3.5 L 2,8.5 L 12,13.5 L 22,8.5 Z"
                                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                                  StrokeLineJoin="Round" />
                                                            <Path Data="M 6,10.8 L 6,16.2 C 6,18.2 8.7,19.8 12,19.8 C 15.3,19.8 18,18.2 18,16.2 L 18,10.8"
                                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            <Path Data="M 21,8.8 L 21,15.5"
                                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.9"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Sẵn sàng cho một ngày học mới?"
                                                               FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Dashboard.EmptyStateText}" Margin="0,5,0,0"
                                                               Style="{StaticResource BodyText}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 3 Student Readiness Steps -->
                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="14,12" Margin="0,0,10,0">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="6" Padding="7,2">
                                                                <TextBlock Text="BƯỚC 1" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{StaticResource PrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="Chuẩn bị góc học" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="Ngồi thẳng lưng, đủ ánh sáng và chuẩn bị sẵn tài liệu cần thiết."
                                                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="14,12" Margin="0,0,10,0">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{StaticResource TealSoftBrush}" CornerRadius="6" Padding="7,2">
                                                                <TextBlock Text="BƯỚC 2" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{StaticResource TealBrush}" />
                                                            </Border>
                                                            <TextBlock Text="Bật chế độ bảo vệ" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="Tự động chặn các trang gây xao nhãng và bắt đầu tính giờ học."
                                                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="14,12">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="7,2">
                                                                <TextBlock Text="BƯỚC 3" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{StaticResource WarningBrush}" />
                                                            </Border>
                                                            <TextBlock Text="Nghỉ mắt hợp lý" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="Áp dụng quy tắc 20-20-20 để đôi mắt và trí não luôn khỏe mạnh."
                                                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Error State -->
                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="12" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Dashboard.ErrorMessage}" FontSize="12.5"
                                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                            <Button Content="Thử lại" Style="{StaticResource QuietDangerButton}"
                                                    HorizontalAlignment="Left" MinHeight="34" Padding="14,6"
                                                    Margin="0,10,0,0"
                                                    Command="{Binding Dashboard.RetryCommand}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Dashboard.LastUpdatedText}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionText}"
                                               Text="EduFocus — đồng hành cùng việc học của bạn." />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB 1: STUDY TIPS (MẸO HỌC TẬP)
                 ============================================================ -->
            <TabItem FocusVisualStyle="{x:Null}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}"
                              Focusable="False"
                              Padding="4,0,4,4">
                    <StackPanel MaxWidth="1060">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="14"
                                            Background="{StaticResource WarningSoftBrush}">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 9,18 L 15,18 M 10,21 L 14,21 M 12,3 C 8.1,3 5,6.1 5,10 C 5,12.4 6.2,14.5 8,15.7 L 8,17 C 8,17.6 8.4,18 9,18 L 15,18 C 15.6,18 16,17.6 16,17 L 16,15.7 C 17.8,14.5 19,12.4 19,10 C 19,6.1 15.9,3 12,3 Z"
                                                      Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Mẹo học tốt" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="Ba thói quen nhỏ giúp mỗi phiên học hiệu quả hơn."
                                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10"
                                                Background="{StaticResource PrimarySoftBrush}">
                                            <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyText}"
                                                   Text="Đặt camera ngang tầm mắt và đủ sáng để nhận diện chính xác." />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10"
                                                Background="{StaticResource TealSoftBrush}">
                                            <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource TealBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyText}"
                                                   Text="Sau mỗi 20 phút, nhìn ra xa 20 giây để mắt được nghỉ." />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10"
                                                Background="{StaticResource WarningSoftBrush}">
                                            <TextBlock Text="3" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyText}"
                                                   Text="Cần mở trang học tập bị chặn? Hãy nhờ phụ huynh kiểm tra cùng bạn." />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Khi một trang bị chặn" Style="{StaticResource CardTitleText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}"
                                           Text="EduFocus hiển thị một trang nhắc nhở thay cho trang web bị chặn, cả khi trang đó dùng HTTPS. Trang nhắc nhở chỉ nằm trên máy này và không tải bất kỳ nội dung nào từ mạng." />
                                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12"
                                        Padding="14" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 6,11 L 18,11 C 19.1,11 20,11.9 20,13 L 20,19 C 20,20.1 19.1,21 18,21 L 6,21 C 4.9,21 4,20.1 4,19 L 4,13 C 4,11.9 4.9,11 6,11 Z"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                <Path Data="M 8,11 L 8,7.5 C 8,5.1 9.8,3.2 12,3.2 C 14.2,3.2 16,5.1 16,7.5 L 16,11"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Nếu trang đó thực sự cần cho việc học, hãy nhờ phụ huynh kiểm tra và mở khóa cùng bạn."
                                                   Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB 2: SETTINGS & PRIVACY (CÀI ĐẶT & RIÊNG TƯ)
                 ============================================================ -->
            <TabItem FocusVisualStyle="{x:Null}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}"
                              Focusable="False"
                              Padding="4,0,4,4">
                    <StackPanel MaxWidth="1060">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="14"
                                            Background="{StaticResource SuccessSoftBrush}">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,2.5 L 19.5,5.8 L 19.5,11.5 C 19.5,16.5 16.3,20.2 12,21.5 C 7.7,20.2 4.5,16.5 4.5,11.5 L 4.5,5.8 Z"
                                                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                <Path Data="M 8.8,12 L 11,14.2 L 15.4,9.8"
                                                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Riêng tư trên máy này" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="Dữ liệu học tập chỉ nằm trên máy của bạn."
                                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource BodyText}"
                                           Text="EduFocus không lưu ảnh hay video từ camera. Toàn bộ dữ liệu học tập được mã hóa và lưu cục bộ trên máy này." />
                                <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10"
                                        Padding="12,8" Margin="0,14,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 5,12.5 L 9.5,17 L 19,7.5"
                                                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Không có tài khoản đám mây" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Updates: deliberately quiet for students -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="12"
                                                Background="{StaticResource SurfaceAltBrush}">
                                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 12,4 L 12,15 M 7.5,11 L 12,15.5 L 16.5,11 M 5,19 L 19,19"
                                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="Cập nhật EduFocus" Style="{StaticResource CardTitleText}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource PillBorder}" Padding="10,4" Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceAltBrush}">
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="v" /><Run Text="{Binding Update.CurrentVersion, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="Kiểm tra cập nhật" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" MinHeight="36" Padding="16,8"
                                            Command="{Binding Update.CheckForUpdateCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding Update.StatusMessage}" Margin="0,12,0,0"
                                           Style="{StaticResource BodyText}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                           Text="Chỉ kiểm tra khi bạn bấm nút. EduFocus gửi phiên bản ứng dụng tới GitHub; không có dữ liệu học tập nào được gửi." />

                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}">
                                                <Run Text="Đã có bản cập nhật v" /><Run Text="{Binding Update.LatestVersion, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Update.ReleaseNotes}" Margin="0,6,0,0"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <Button Content="Tải và cài đặt" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" MinHeight="36" Padding="16,8"
                                                    Margin="0,12,0,0"
                                                    Command="{Binding Update.DownloadAndInstallCommand}" />
                                            <ProgressBar Height="5" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding Update.DownloadProgress}"
                                                         Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB 3: ABOUT US (VỀ CHÚNG TÔI — NHÀ PHÁT TRIỂN)
                 ============================================================ -->
            <TabItem FocusVisualStyle="{x:Null}">
