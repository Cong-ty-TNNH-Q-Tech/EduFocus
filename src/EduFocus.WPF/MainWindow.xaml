<Window x:Class="EduFocus.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduFocus"
        Height="760" Width="1060"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="36,26,36,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EduFocus" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Không gian học tập của bạn" Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,9"
                    Click="ParentModeButton_Click"
                    ToolTip="Đăng nhập PIN phụ huynh để quản lý các cài đặt được bảo vệ">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Phụ huynh" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="36,22,36,30">
            <StackPanel MaxWidth="1080">

                <!-- Hero: protection status -->
                <Border CornerRadius="24" Padding="30,28" Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource HeroPausedGradientBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <Border Background="#2EFFFFFF" CornerRadius="999" Padding="12,6"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFD37A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="#8CFFC1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="ĐANG BẢO VỆ" Margin="8,0,0,0" FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="CHƯA BẬT BẢO VỆ" Margin="8,0,0,0" FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,16,0,0" FontSize="30" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap"
                                       Text="Bảo vệ đang bật"
                                       Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,16,0,0" FontSize="30" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap"
                                       Text="Bảo vệ đang tắt">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Protection.StatusText}" Margin="0,8,0,0"
                                       FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                       Foreground="#EDEBFF" MaxWidth="580" />

                            <TextBlock Text="{Binding Protection.WarningText}" Margin="0,12,0,0"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="#FFE4B8"
                                       Visibility="{Binding Protection.HasWarning, Converter={StaticResource BoolToVisibility}}" />

                            <Border Background="#24FFFFFF" CornerRadius="10" Padding="12,7"
                                    HorizontalAlignment="Left" Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Camera.IndicatorBrush}" />
                                    <TextBlock Text="{Binding Camera.StatusText}" Margin="8,0,0,0"
                                               FontSize="12.5" Foreground="#F4F2FF"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="520" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Camera.GuidanceText}" Margin="0,8,0,0"
                                       FontSize="12" TextWrapping="Wrap" Foreground="#FFE4B8"
                                       MaxWidth="560"
                                       Visibility="{Binding Camera.HasGuidance, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="118" Height="118" CornerRadius="59"
                                Background="#22FFFFFF" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Protection.IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                           Foreground="#FFE4B8" HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Protection.IsEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quick stats -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock Text="&#xE7BE;" Style="{StaticResource IconGlyph}" FontSize="20"
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Thời gian học hôm nay" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Dashboard.StudyTimeText}" FontSize="19"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource TealSoftBrush}">
                                <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}" FontSize="20"
                                           Foreground="{StaticResource TealBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Phiên học hôm nay" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Dashboard.SessionCountText}" FontSize="19"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource WarningSoftBrush}">
                                <TextBlock Text="&#xE722;" Style="{StaticResource IconGlyph}" FontSize="20"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Camera" Style="{StaticResource CaptionText}" />
                                    <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                             Fill="{Binding Camera.IndicatorBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Camera.StatusText}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Today + tips -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,18,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" FontSize="17"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="Hôm nay của bạn" Style="{StaticResource SectionTitleText}"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource PillBorder}" Padding="10,4">
                                    <TextBlock Text="{Binding Dashboard.DateLabel}" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />
                                </Border>
                            </Grid>

                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                                         Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding Dashboard.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Dashboard.StudentStudyText}" FontSize="22"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.ActiveSessionText}" Margin="0,8,0,0"
                                           Style="{StaticResource BodyText}" />
                                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12"
                                        Padding="14" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE82F;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                   Text="Mỗi phiên học đều được ghi nhận riêng trên máy này — không có dữ liệu nào bị gửi lên mạng." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding Dashboard.ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7BE;" Style="{StaticResource IconGlyph}" FontSize="28"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="Sẵn sàng cho một ngày học mới?" Margin="0,10,0,0"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Dashboard.EmptyStateText}" Margin="0,6,0,0"
                                                   Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Dashboard.ErrorMessage}" FontSize="12.5"
                                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                        <Button Content="Thử lại" Style="{StaticResource QuietDangerButton}"
                                                HorizontalAlignment="Left" MinHeight="34" Padding="14,6"
                                                Margin="0,10,0,0"
                                                Command="{Binding Dashboard.RetryCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Dashboard.LastUpdatedText}" Margin="0,14,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorder}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE82F;" Style="{StaticResource IconGlyph}" FontSize="17"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Mẹo học tốt" Style="{StaticResource SectionTitleText}"
                                               Margin="9,0,0,0" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="10"
                                                Background="{StaticResource PrimarySoftBrush}">
                                            <TextBlock Text="1" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryText}"
                                                   Text="Đặt camera ngang tầm mắt và đủ sáng để nhận diện chính xác." />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="10"
                                                Background="{StaticResource TealSoftBrush}">
                                            <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource TealBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryText}"
                                                   Text="Sau mỗi 20 phút, nhìn ra xa 20 giây để mắt được nghỉ." />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="10"
                                                Background="{StaticResource WarningSoftBrush}">
                                            <TextBlock Text="3" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryText}"
                                                   Text="Cần mở trang học tập bị chặn? Hãy nhờ phụ huynh kiểm tra cùng bạn." />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Riêng tư trên máy này" Style="{StaticResource CardTitleText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}"
                                           Text="EduFocus không lưu ảnh hay video từ camera. Dữ liệu học tập chỉ nằm trên máy của bạn." />
                                <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10"
                                        Padding="10,8" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="14"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="Không có tài khoản đám mây" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Updates: deliberately quiet for students -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="16"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Cập nhật EduFocus" Style="{StaticResource CardTitleText}"
                                           Margin="9,0,0,0" />
                                <Border Style="{StaticResource PillBorder}" Padding="9,3" Margin="10,0,0,0"
                                        Background="{StaticResource SurfaceAltBrush}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="v" />
                                        <Run Text="{Binding Update.CurrentVersion, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <Button Content="Kiểm tra cập nhật" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" MinHeight="34" Padding="14,7"
                                    Command="{Binding Update.CheckForUpdateCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding Update.StatusMessage}" Margin="0,10,0,0"
                                   Style="{StaticResource SecondaryText}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="Chỉ kiểm tra khi bạn bấm nút. EduFocus gửi phiên bản ứng dụng tới GitHub; không có dữ liệu học tập nào được gửi." />

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}">
                                        <Run Text="Đã có bản cập nhật v" />
                                        <Run Text="{Binding Update.LatestVersion, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Update.ReleaseNotes}" Margin="0,6,0,0"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="Tải và cài đặt" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" MinHeight="34" Padding="14,7"
                                            Margin="0,10,0,0"
                                            Command="{Binding Update.DownloadAndInstallCommand}" />
                                    <ProgressBar Height="5" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Update.DownloadProgress}"
                                                 Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,20,0,0" Style="{StaticResource CaptionText}"
                           Text="EduFocus — đồng hành cùng việc học của bạn." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
