                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Đồng hành cùng gia đình" Style="{StaticResource CardTitleText}" Margin="0,12,0,0" />
                                    <TextBlock Text="Kết nối minh bạch giữa học sinh và phụ huynh thông qua lịch trình thông minh và báo cáo học tập trực quan."
                                               Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
