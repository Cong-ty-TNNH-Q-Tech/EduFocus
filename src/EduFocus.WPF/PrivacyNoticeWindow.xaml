<Window x:Class="EduFocus.WPF.PrivacyNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông báo quyền riêng tư — EduFocus"
        Height="740" Width="880"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F9"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Thông báo quyền riêng tư"
                           FontSize="24" FontWeight="SemiBold" Foreground="#1F2430" />
                <TextBlock Text="EduFocus 2.0.0 · Bản đang áp dụng được cài kèm tại docs\privacy-notice.md"
                           FontSize="12" Foreground="#5B6270" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" Background="White" CornerRadius="12"
                BorderBrush="#E1E4EC" BorderThickness="1" Padding="8">
            <FlowDocumentScrollViewer x:Name="NoticeViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      AutomationProperties.Name="Nội dung thông báo quyền riêng tư"
                                      Padding="18,14" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Đóng" IsDefault="True" IsCancel="True"
                    Padding="22,9" MinWidth="110" FontSize="14" FontWeight="SemiBold"
                    Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
