<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version is injected by CI from git tag, e.g. 1.2.3 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>EduFocus.Service</AssemblyName>
    <RootNamespace>EduFocus.Service</RootNamespace>
    <Product>EduFocus</Product>
    <Copyright>Copyright © 2026 ThanhTrunggDEV</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduFocus.Ports\EduFocus.Ports.csproj" />
    <ProjectReference Include="..\EduFocus.Infrastructure\EduFocus.Infrastructure.csproj" />
    <ProjectReference Include="..\EduFocus.UseCases\EduFocus.UseCases.csproj" />
    <ProjectReference Include="..\EduFocus.SqliteDataAccess\EduFocus.SqliteDataAccess.csproj" />
  </ItemGroup>

</Project>
