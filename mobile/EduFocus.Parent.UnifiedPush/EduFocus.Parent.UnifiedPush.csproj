    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <AndroidMavenLibrary Include="org.unifiedpush.android:connector" Version="3.3.6" />
