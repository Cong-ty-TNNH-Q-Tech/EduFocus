<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="EduFocus.Parent.App.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduFocus.Parent.Core.Presentation;assembly=EduFocus.Parent.Core"
             x:DataType="vm:NotificationsViewModel"
             Title="Thông báo"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}">
    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,32" Spacing="14">
                <Label Text="Thông báo"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

                <Border IsVisible="{Binding IsShowingCachedData}"
                        Padding="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
                    <Label Text="{Binding CachedBannerText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" />
                </Border>

                <Border IsVisible="{Binding HasError}"
                        Padding="14"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}" />
                        <Button Text="Thử lại"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="40"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <Border Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tùy chọn thông báo"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                            <Label Text="Cảnh báo tập trung"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding AttentionAlert}"
                                    IsEnabled="{Binding CanEditPreferences}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tổng kết ngày"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding DailySummary}"
                                    IsEnabled="{Binding CanEditPreferences}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Bảo vệ tạm tắt"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding ProtectionOff}"
                                    IsEnabled="{Binding CanEditPreferences}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Cảnh báo bảo mật"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding SecurityAlert}"
                                    IsEnabled="{Binding CanEditPreferences}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#1F2937}" />

                        <Label Text="Giờ yên tĩnh"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Bắt đầu"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <TimePicker Time="{Binding QuietStart, Mode=TwoWay}"
                                            Format="HH:mm"
                                            IsEnabled="{Binding CanEditPreferences}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Kết thúc"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <TimePicker Time="{Binding QuietEnd, Mode=TwoWay}"
                                            Format="HH:mm"
                                            IsEnabled="{Binding CanEditPreferences}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Giờ tổng kết ngày"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <TimePicker Time="{Binding DailySummaryTime, Mode=TwoWay}"
                                        Format="HH:mm"
                                        IsEnabled="{Binding CanEditPreferences}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </VerticalStackLayout>

                        <Button Text="Lưu tùy chọn"
                                Command="{Binding SavePreferencesCommand}"
                                IsEnabled="{Binding CanEditPreferences}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44" />

                        <Label Text="{Binding PreferencesStatus}"
                               IsVisible="{Binding HasPreferencesStatus}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding PreferencesStatusIsError}"
                                             Value="True">
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Lịch sử thông báo"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationItem">
                            <Border Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding CategoryText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    <Label Text="{Binding TimeText}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    <Label Text="{Binding StatusText}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Tải thêm"
                        IsVisible="{Binding CanLoadMore}"
                        Command="{Binding LoadMoreCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="44" />

                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <Border IsVisible="{Binding ShowEmptyState}"
                        Padding="20"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Chưa có thông báo"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        <Label Text="Cảnh báo và tổng kết ngày sẽ xuất hiện ở đây."
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
