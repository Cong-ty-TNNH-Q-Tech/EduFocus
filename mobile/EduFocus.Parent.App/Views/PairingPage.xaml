<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="EduFocus.Parent.App.Views.PairingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduFocus.Parent.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:PairingViewModel"
             Title="Ghép nối"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <Button Text="← Quay lại"
                    Clicked="OnBackClicked"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start" />

            <VerticalStackLayout Spacing="2">
                <Label Text="GHÉP NỐI" Style="{StaticResource EyebrowLabel}" />
                <Label Text="Ghép nối với máy tính" Style="{StaticResource PageTitleLabel}" />
                <Label Text="Quét mã QR hoặc nhập mã 8 ký tự từ Parent Mode trên máy tính."
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,3,0,0" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsAlreadyLinked}"
                    Style="{StaticResource CardBorder}"
                    Padding="14"
                    Stroke="{AppThemeBinding Light=#F5C66B, Dark=#5A4413}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AmberSoft}, Dark={StaticResource AmberSoftDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="icon_alert.png" WidthRequest="18" HeightRequest="18"
                           Aspect="AspectFit" VerticalOptions="Start" Margin="0,1,0,0">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Grid.Column="1"
                           Text="{Binding LinkedBannerText}"
                           FontSize="12.5"
                           LineHeight="1.35"
                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SoftCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="CÁCH GHÉP NỐI" Style="{StaticResource EyebrowLabel}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                BackgroundColor="{StaticResource Primary}" VerticalOptions="Start">
                            <Label Text="1" FontSize="12" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Trên máy tính, mở EduFocus → Parent Mode → Điện thoại."
                               Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                BackgroundColor="{StaticResource Primary}" VerticalOptions="Start">
                            <Label Text="2" FontSize="12" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Tạo mã ghép nối (QR hoặc mã 8 ký tự)."
                               Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                BackgroundColor="{StaticResource Primary}" VerticalOptions="Start">
                            <Label Text="3" FontSize="12" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Quét QR hoặc nhập mã bên dưới để hoàn tất."
                               Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconBadge}" WidthRequest="38" HeightRequest="38"
                                StrokeShape="RoundRectangle 12">
                            <Image Source="icon_scan.png" WidthRequest="20" HeightRequest="20"
                                   Aspect="AspectFit">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Quét mã QR" Style="{StaticResource SectionLabel}" />
                            <Label Text="Camera chỉ dùng để đọc mã QR; ứng dụng không lưu hình ảnh."
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="ScannerHost"
                            IsVisible="{Binding IsScannerActive}"
                            HeightRequest="250"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#0B1220" />

                    <Button Text="Bật camera quét QR"
                            Clicked="OnToggleScannerClicked"
                            IsVisible="{Binding ShowStartScanner}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Text="Tắt camera"
                            Clicked="OnToggleScannerClicked"
                            IsVisible="{Binding ShowStopScanner}"
                            Style="{StaticResource SecondaryButton}" />

                    <Button Text="Mở cài đặt quyền camera"
                            Clicked="OnOpenPermissionSettingsClicked"
                            IsVisible="{Binding CameraPermissionDenied}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12.5" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="4,2">
                <BoxView HeightRequest="1" VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Label Grid.Column="1" Text="hoặc nhập mã thủ công"
                       Style="{StaticResource CaptionLabel}" />
                <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mã ghép nối" Style="{StaticResource CardTitleLabel}" />
                        <Border Style="{StaticResource InputBorder}" Padding="14,2">
                            <Entry Text="{Binding CodeInput}"
                                   Placeholder="ABCD-2345"
                                   MaxLength="11"
                                   Keyboard="Text"
                                   FontSize="22"
                                   CharacterSpacing="2"
                                   HorizontalTextAlignment="Center"
                                   IsEnabled="{Binding IsNotBusy}"
                                   Style="{StaticResource InputEntry}"
                                   HeightRequest="52" />
                        </Border>
                        <Label Text="Mã gồm 8 ký tự chữ và số, hiển thị trên màn hình máy tính."
                               Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image Source="icon_cloud.png" WidthRequest="16" HeightRequest="16"
                                   Aspect="AspectFit" VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Grid.Column="1" Text="Máy chủ cloud" Style="{StaticResource CardTitleLabel}" />
                        </Grid>
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding CloudBaseUrl}"
                                   Placeholder="https://cloud.example.com"
                                   Keyboard="Url"
                                   IsEnabled="{Binding IsNotBusy}"
                                   Style="{StaticResource InputEntry}" />
                        </Border>
                        <Label Text="Chỉ đổi khi bạn tự vận hành máy chủ. Quét QR sẽ tự điền địa chỉ này."
                               Style="{StaticResource CaptionLabel}" />
                        <Label Text="Địa chỉ http không mã hóa chỉ dùng khi thử nghiệm trong mạng LAN."
                               IsVisible="{Binding IsInsecureUrl}"
                               Style="{StaticResource CaptionLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}" />
                    </VerticalStackLayout>

                    <Button Text="Ghép nối"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Border IsVisible="{Binding HasStatusMessage}"
                    Style="{StaticResource SoftCardBorder}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding StatusIsError}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       LineHeight="1.35"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding StatusIsError}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <Label Text="{Binding RetryText}"
                   IsVisible="{Binding IsRateLimited}"
                   Style="{StaticResource CaptionLabel}"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
