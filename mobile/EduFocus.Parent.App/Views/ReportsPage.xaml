<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="EduFocus.Parent.App.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduFocus.Parent.Core.Presentation;assembly=EduFocus.Parent.Core"
             xmlns:controls="clr-namespace:EduFocus.Parent.App.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:ReportsViewModel"
             Title="Báo cáo"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container">
    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">

                <VerticalStackLayout Spacing="2">
                    <Label Text="BÁO CÁO" Style="{StaticResource EyebrowLabel}" />
                    <Label Text="7 ngày gần nhất" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="{Binding RangeText}" Style="{StaticResource CaptionLabel}"
                           Margin="0,3,0,0" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding IsShowingCachedData}"
                        Style="{StaticResource CardBorder}"
                        Padding="14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AmberSoft}, Dark={StaticResource AmberSoftDark}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icon_alert.png" WidthRequest="18" HeightRequest="18"
                               Aspect="AspectFit" VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Grid.Column="1"
                               Text="{Binding CachedBannerText}"
                               FontSize="12.5"
                               TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource CardBorder}"
                        Padding="16"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_alert.png" WidthRequest="18" HeightRequest="18"
                                   Aspect="AspectFit" VerticalOptions="Start" Margin="0,1,0,0">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Grid.Column="1"
                                   Text="{Binding ErrorMessage}"
                                   FontSize="12.5"
                                   LineHeight="1.35"
                                   TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}" />
                        </Grid>
                        <Button Text="Thử lại"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="42"
                                HorizontalOptions="Start"
                                Padding="18,0" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   Margin="0,8" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding HasDays}">
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tổng 7 ngày" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding TotalStudyText}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Trung bình / ngày" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding AverageStudyText}"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding HasDays}" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Thời gian học theo ngày" Style="{StaticResource SectionLabel}" />
                                <Label Text="Chạm vào một ngày bên dưới để xem chi tiết."
                                       Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    Style="{StaticResource PillBorder}"
                                    VerticalOptions="Start">
                                <Label Text="7 ngày"
                                       Style="{StaticResource PillLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}" />
                            </Border>
                        </Grid>
                        <controls:WeeklyBarChart Bars="{Binding ChartBars}"
                                                 HeightRequest="168" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasSelection}" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="CHI TIẾT NGÀY" Style="{StaticResource EyebrowLabel}" />
                            <Label Text="{Binding SelectedDateText}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="18"
                              RowSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Thời gian học" Style="{StaticResource MetricLabel}" />
                                <Label Text="{Binding SelectedStudyText}" Style="{StaticResource MetricValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Số lần bị chặn" Style="{StaticResource MetricLabel}" />
                                <Label Text="{Binding SelectedBlockedText}" Style="{StaticResource MetricValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Spacing="6">
                                <Label Text="Tập trung" Style="{StaticResource MetricLabel}" />
                                <Label Text="{Binding SelectedAttentionText}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}" />
                                <ProgressBar Progress="{Binding SelectedAttentionPercentValue}"
                                             Style="{StaticResource MetricProgress}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Text="Độ phủ dữ liệu" Style="{StaticResource MetricLabel}" />
                                <Label Text="{Binding SelectedCoverageText}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Blue}, Dark=#93C5FD}" />
                                <ProgressBar Progress="{Binding SelectedCoveragePercentValue}"
                                             Style="{StaticResource MetricProgress}"
                                             ProgressColor="{AppThemeBinding Light={StaticResource Blue}, Dark=#93C5FD}" />
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="7"
                                               IsVisible="{Binding SelectedShowCoverageWarning}">
                            <Image Source="icon_alert.png" WidthRequest="15" HeightRequest="15"
                                   Aspect="AspectFit" VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="Dữ liệu chưa đủ tin cậy"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Amber}, Dark=#FCD34D}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasDays}" Spacing="10">
                    <Label Text="Từng ngày" Style="{StaticResource SectionLabel}" Margin="2,4,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReportDayItem">
                                <Border Style="{StaticResource CardBorder}" Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DateText}"
                                                   FontSize="14"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding AttentionCoverageText}"
                                                   Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding StudyText}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}"
                                               VerticalOptions="Center" />
                                        <Image Grid.Column="2"
                                               Source="icon_chevron_right.png"
                                               WidthRequest="15"
                                               HeightRequest="15"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border IsVisible="{Binding ShowEmptyState}" Style="{StaticResource CardBorder}" Padding="22">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}">
                            <Image Source="icon_database.png" WidthRequest="24" HeightRequest="24"
                                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5EEAD4}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <Label Text="Chưa có báo cáo"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Báo cáo 7 ngày sẽ xuất hiện sau khi máy tính gửi dữ liệu tổng hợp."
                               Style="{StaticResource CaptionLabel}"
                               HorizontalTextAlignment="Center"
                               MaxLines="3" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
