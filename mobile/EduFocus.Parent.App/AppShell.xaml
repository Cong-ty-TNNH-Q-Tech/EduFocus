<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="EduFocus.Parent.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:EduFocus.Parent.App.Views"
       Title="EduFocus Phụ huynh"
       FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent Title="Tổng quan"
                      Route="overview"
                      ContentTemplate="{DataTemplate views:OverviewPage}" />
        <ShellContent Title="Báo cáo"
                      Route="reports"
                      ContentTemplate="{DataTemplate views:ReportsPage}" />
        <ShellContent Title="Thông báo"
                      Route="notifications"
                      ContentTemplate="{DataTemplate views:NotificationsPage}" />
        <ShellContent Title="Cài đặt"
                      Route="settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

    <ShellContent Route="welcome"
                  ContentTemplate="{DataTemplate views:WelcomePage}" />
    <ShellContent Route="pairing"
                  ContentTemplate="{DataTemplate views:PairingPage}" />
    <ShellContent Route="privacy"
                  ContentTemplate="{DataTemplate views:PrivacyPage}" />
</Shell>
