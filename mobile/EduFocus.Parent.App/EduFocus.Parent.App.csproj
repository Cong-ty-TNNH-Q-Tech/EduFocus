<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EduFocus.Parent.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>EduFocus Phụ huynh</ApplicationTitle>
    <ApplicationId>com.qtech.edufocus.parent</ApplicationId>

    <!-- Release workflow overrides both values from the git tag.
         versionCode = major*10000 + minor*100 + patch; see mobile/README.md. -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <MauiVersion>10.0.30</MauiVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(Configuration)' != 'Debug'">apk;aab</AndroidPackageFormats>
    <AndroidManifestPlaceholders Condition="'$(Configuration)' == 'Debug'">usesCleartextTraffic=true</AndroidManifestPlaceholders>
    <AndroidManifestPlaceholders Condition="'$(Configuration)' != 'Debug'">usesCleartextTraffic=false</AndroidManifestPlaceholders>

    <!-- FCM is compiled in only when a Firebase config is provided (local dev
         file or CI secret). The file is never committed. -->
    <GoogleServicesJsonFile Condition="'$(GoogleServicesJsonFile)' == ''">google-services.json</GoogleServicesJsonFile>
    <EnableFirebase Condition="Exists('$(GoogleServicesJsonFile)')">true</EnableFirebase>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableFirebase)' == 'true'">
    <DefineConstants>$(DefineConstants);FCM_ENABLED</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableFirebase)' == 'true'">
    <GoogleServicesJson Include="$(GoogleServicesJsonFile)" />
    <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F766E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F766E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduFocus.Parent.Core\EduFocus.Parent.Core.csproj" />
  </ItemGroup>

</Project>
