{
  "manifest_version": 3,
  "name": "EduFocus – Chặn web xao nhãng",
  "version": "1.0.0",
  "description": "Chặn URL và đường dẫn theo danh sách của phụ huynh khi EduFocus đang bảo vệ phiên học.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EduFocus",
    "default_popup": "popup.html"
  }
}
